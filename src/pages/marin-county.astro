---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import SectionIntro from '@/components/SectionIntro.astro';
import Grid from '@/components/Grid.astro';
import Button from '@/components/Button.astro';
import Rating from '@/components/Rating.astro';
import mountTam from '@/assets/img/locations/marin-mount-tam.jpg';
import ServiceCard from '@/components/ServiceCard.astro';
import AreaList from '@/components/AreaList.astro';
import NameStrip from '@/components/NameStrip.astro';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import ReviewQuote from '@/components/ReviewQuote.astro';
import CtaBand from '@/components/CtaBand.astro';
import Phone from '@/components/Phone.astro';
import Feature from '@/components/Feature.astro';
import FaqList from '@/components/FaqList.astro';
import { TOWNS } from '@/data/towns';
import type { Faq } from '@/data/faqs';
import { SITE, OFFICES } from '@/config/site';
import { SERVICES } from '@/data/services';
import { MARIN_TOWNS, MARIN_CLIENTS } from '@/data/locations';
import { REVIEWS } from '@/data/reviews';

const office = OFFICES.marin;

const areaNotes = [
  {
    title: 'Mill Valley and Sausalito',
    text: 'Southern Marin sits right next to San Francisco, so local businesses often compete with city firms. A sharp local profile and clear reviews help you stand out.',
  },
  {
    title: 'Larkspur, Corte Madera and the Ross Valley',
    text: 'Short drives but distinct towns. Naming San Anselmo, Fairfax, Ross and Kentfield on your site helps Google connect you to each.',
  },
  {
    title: 'Tiburon and Belvedere',
    text: 'Small, high-value markets where word of mouth meets search. A polished site and a handful of strong reviews go a long way.',
  },
];

const faqs: Faq[] = [
  {
    q: 'Do you meet clients in person in Marin?',
    a: 'We start with a free Google Meet call so we can look at your site together. After that, I’m happy to meet at your office anywhere in Marin if it helps.',
  },
  {
    q: 'Which Marin towns do you work in?',
    a: 'All of them, from Novato to Sausalito and out to West Marin, plus Petaluma and southern Sonoma.',
  },
  {
    q: 'Can one person really handle my website, SEO and ads?',
    a: 'For most local service businesses, yes. You get one point of contact who knows your site, your rankings and your ad account, so nothing falls between vendors.',
  },
];
const local: Record<string, { title: string; summary: string; href?: string }> = {
  'web-design': {
    title: 'Marin web design',
    summary: 'Fast, accessible WordPress sites for Marin service businesses, nonprofits and professional firms.',
    href: '/marin-county/web-design/',
  },
  care: { title: 'WordPress care plans', summary: 'Weekly updates, daily security scans and unlimited quick fixes. From $249 a month.' },
  'local-seo': {
    title: 'Marin local SEO',
    summary: 'Get into the map pack for searches in Novato, San Rafael and across the county. From $1,495 a month.',
    href: '/marin-county/seo/',
  },
  'google-ads': {
    title: 'Google Ads in Marin',
    summary: 'Local campaigns targeted to Marin and southern Sonoma, for one flat monthly fee.',
  },
};
---

<BaseLayout
  title="Marin County Web Design, SEO & Google Ads | PartnerPress"
  description="WordPress design, care plans, Local SEO and Google Ads for Marin County businesses, from Novato to Sausalito. Call (415) 390-6563."
  nav="locations"
  office="marin"
  schema={['marin']}
>
  <PageHero
    eyebrow="Marin County, CA · Based in Novato"
    title="WordPress, Local SEO and Google Ads for Marin County businesses"
    bg={mountTam}
  >
    <Fragment slot="lead">
      Marin businesses have trusted me with their websites since 2010. One local expert for your site, your Google rankings
      and your ads, from Novato to Sausalito.
    </Fragment>
    <Fragment slot="actions">
      <Button href="/contact/" size="lg">Book a free call</Button>
      <span class="call">or call <Phone office="marin" strong /></span>
    </Fragment>
    <Rating slot="meta" />
  </PageHero>

  <Section>
    <SectionIntro title="What I do for Marin businesses" />
    <Grid min={250} gap="20px">
      {SERVICES.map((s) => <ServiceCard service={{ ...s, href: local[s.key].href ?? s.href }} detailed={false} title={local[s.key].title} summary={local[s.key].summary} />)}
    </Grid>
  </Section>

  <Section tone="subtle" compact>
    <AreaList title="Towns I serve" areas={MARIN_TOWNS}>
      Most work happens over Google Meet, and I can visit your office anywhere in Marin when it helps.
    </AreaList>
  </Section>

  <Section>
    <SectionIntro eyebrow="Around Marin" title="Every Marin town searches a little differently">
      Google ranks local businesses by distance as much as quality, so I plan for the towns you want to reach.
    </SectionIntro>
    <Grid min={320} gap="20px">
      {
        TOWNS.map((t) => (
          <Feature title={`Web design and SEO in ${t.name}`} href={`/marin-county/${t.slug}/`} boxed>
            {t.teaser}
          </Feature>
        ))
      }
    </Grid>
    <Grid min={260} gap="32px 28px" class="area-notes">
      {areaNotes.map((n) => <Feature title={n.title}>{n.text}</Feature>)}
    </Grid>
  </Section>

  <Section>
    <SectionIntro title="Trusted by Marin organizations" />
    <NameStrip names={MARIN_CLIENTS} align="start" />
    <Grid min={340}>
      <CaseStudyCard label="Marin client story" result="[Marin client] · [RESULT]" text="[Two sentences on the problem and what changed.]" image={false} />
      <ReviewQuote review={REVIEWS.krivatsy} variant="tint" />
    </Grid>
  </Section>

  <Section width="narrow">
    <FaqList faqs={faqs} title="Marin County questions" />
  </Section>

  <CtaBand title="Talk to a Marin WordPress expert">
    <address>
      {SITE.name}, {office.street}, {office.city}, {office.region}
      {office.postalCode} · <Phone office="marin" strong />
    </address>
  </CtaBand>
</BaseLayout>

<style>
  :global(.area-notes) {
    margin-top: 40px;
  }

  .call {
    font-size: 18px;
    color: var(--text-strong);
  }
</style>
