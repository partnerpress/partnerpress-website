---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Button from '@/components/Button.astro';
import Rating from '@/components/Rating.astro';
import mountTam from '@/assets/img/locations/marin-mount-tam.jpg';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import msaShot from '@/assets/img/work/marin-school-of-the-arts.jpg';
import CtaBand from '@/components/CtaBand.astro';
import Phone from '@/components/Phone.astro';
import ProofStrip from '@/components/local/ProofStrip.astro';
import NumberedCards from '@/components/local/NumberedCards.astro';
import AreaBand from '@/components/local/AreaBand.astro';
import ServiceShowcase from '@/components/local/ServiceShowcase.astro';
import ImageCards from '@/components/local/ImageCards.astro';
import TrustBand from '@/components/local/TrustBand.astro';
import FaqSplit from '@/components/local/FaqSplit.astro';
import { TOWNS } from '@/data/towns';
import type { Faq } from '@/data/faqs';
import { SITE, OFFICES } from '@/config/site';
import { MARIN_CLIENTS } from '@/data/locations';
import { REVIEWS } from '@/data/reviews';

const office = OFFICES.marin;

const faqs: Faq[] = [
  {
    q: 'Do you meet clients in person in Marin?',
    a: 'We start with a free Google Meet call so we can look at your site together. After that, I’m happy to meet at your office anywhere in Marin if it helps.',
  },
  {
    q: 'Which Marin towns do you work in?',
    a: 'All of them, from Novato to Sausalito and out to West Marin, plus Petaluma and southern Sonoma.',
  },
  {
    q: 'Can one person really handle my website, SEO and ads?',
    a: 'For most local service businesses, yes. You get one point of contact who knows your site, your rankings and your ad account, so nothing falls between vendors.',
  },
];
---

<BaseLayout
  title="Marin County Web Design, SEO & Google Ads | PartnerPress"
  description="Web design, WordPress care, Local SEO and Google Ads for Marin County businesses, from Novato to Sausalito. Call (415) 390-6563."
  nav="locations"
  office="marin"
  schema={['marin']}
>
  <PageHero
    eyebrow="Marin County, CA · Based in Novato"
    title="Web design, Local SEO and Google Ads for Marin County businesses"
    bg={mountTam}
  >
    <Fragment slot="lead">
      Marin businesses have trusted me with their websites since 2010. One local expert for your site, your Google rankings
      and your ads, from Novato to Sausalito.
    </Fragment>
    <Fragment slot="actions">
      <Button href="/contact/" size="lg">Book a free call</Button>
      <span class="call">or call <Phone office="marin" strong /></span>
    </Fragment>
    <Rating slot="meta" />
  </PageHero>

  <ProofStrip
    items={[
      { icon: 'calendar', value: 'Since 2010', label: 'Building Marin websites' },
      { icon: 'star', value: `${SITE.reviews.rating} rating`, label: `From ${SITE.reviews.count} Google reviews`, accent: true },
      { icon: 'home', value: 'Based in Novato', label: 'Local to Marin' },
      { icon: 'video', value: 'Meet first', label: 'Free Google Meet call' },
    ]}
  />

  <ServiceShowcase
    tone="white"
    title="What I do for Marin businesses"
    featured={[
      {
        icon: 'layout',
        tag: 'Fixed quote up front',
        title: 'Marin web design',
        href: '/marin-county/web-design/',
        text: 'Fast, secure, accessible websites for Marin service businesses, nonprofits and professional firms.',
        more: 'See Marin web design',
      },
      {
        icon: 'search',
        tag: 'From $1,495/mo',
        title: 'Marin local SEO',
        href: '/marin-county/seo/',
        text: 'Get into the map pack and AI answers for searches in Novato, San Rafael and across the county.',
        more: 'See Marin SEO',
      },
    ]}
    secondary={[
      {
        icon: 'shield',
        title: 'WordPress care plans',
        tag: 'From $249/mo',
        href: '/wordpress-care-plans/',
        text: 'Weekly updates, daily security scans and unlimited quick fixes, plus AI visibility reports on Strive and Arrive.',
        more: 'See care plans',
      },
      {
        icon: 'megaphone',
        title: 'Google Ads in Marin',
        tag: 'One flat fee',
        href: '/google-ads/',
        text: 'Local campaigns targeted to Marin and southern Sonoma, for one flat monthly fee.',
        more: 'See Google Ads',
      },
    ]}
  />

  <ImageCards
    eyebrow="Around Marin"
    title="Every Marin town searches a little differently"
    lead="Google ranks local businesses by distance as much as quality, so I plan for the towns you want to reach."
    items={TOWNS.map((t) => ({
      image: t.hero,
      imagePosition: t.heroPosition,
      title: t.name,
      text: t.teaser,
      href: `/marin-county/${t.slug}/`,
      more: `Web design and SEO in ${t.name}`,
    }))}
  />

  <NumberedCards
    eyebrow="Beyond the town pages"
    title="What the rest of Marin needs"
    items={[
      {
        icon: 'store',
        title: 'Mill Valley and Sausalito',
        text: 'Southern Marin sits right next to San Francisco, so local businesses often compete with city firms. A sharp local profile and clear reviews help you stand out.',
      },
      {
        icon: 'map',
        title: 'Larkspur, Corte Madera and the Ross Valley',
        text: 'Short drives but distinct towns. Naming San Anselmo, Fairfax, Ross and Kentfield on your site helps Google connect you to each.',
      },
      {
        icon: 'trending',
        title: 'Tiburon and Belvedere',
        text: 'Small, high-value markets where word of mouth meets search. A polished site and a handful of strong reviews go a long way.',
      },
    ]}
  />

  <AreaBand
    title="Towns I serve"
    groups={[
      { label: 'North Marin and Sonoma', areas: ['Novato', 'Petaluma'] },
      { label: 'Central Marin', areas: ['San Rafael', 'Larkspur', 'Corte Madera'] },
      { label: 'Ross Valley', areas: ['San Anselmo', 'Fairfax', 'Ross'] },
      { label: 'Southern Marin', areas: ['Mill Valley', 'Sausalito', 'Tiburon', 'Belvedere'] },
    ]}
  >
    Most work happens over Google Meet, and I can visit your office anywhere in Marin when it helps.
  </AreaBand>

  <TrustBand title="Trusted by Marin organizations" names={MARIN_CLIENTS} review={REVIEWS.krivatsy} scoreNote="Building Marin websites since 2010">
    <div class="story">
    <CaseStudyCard
      label="Marin client story · Novato"
      result="Marin School of the Arts"
      text="I rebuilt the school's website just as Covid hit, with online giving through GiveWP built in. Since launch, the site has raised hundreds of thousands of dollars in donations."
      shot={msaShot}
      alt="Marin School of the Arts home page"
    />
    </div>
  </TrustBand>

  <FaqSplit title="Marin County questions" faqs={faqs} flush />

  <CtaBand title="Talk to a Marin web and SEO expert">
    <address>
      {SITE.name}, {office.street}, {office.city}, {office.region}{" "}
      {office.postalCode} · <Phone office="marin" strong />
    </address>
  </CtaBand>
</BaseLayout>

<style>
  /* Case study sits side by side on wide screens so the screenshot stays sharp */
  @media (min-width: 860px) {
    .story :global(.case) {
      flex-direction: row;
    }
    .story :global(.case__shot) {
      width: 50%;
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }
    .story :global(.case__body) {
      justify-content: center;
      padding: 40px;
    }
  }

  .call {
    font-size: 18px;
    color: var(--text-strong);
  }
</style>
