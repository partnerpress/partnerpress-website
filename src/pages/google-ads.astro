---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import heroPhoto from '@/assets/img/services/google-ads-phone-search.jpg';
import Section from '@/components/Section.astro';
import SectionIntro from '@/components/SectionIntro.astro';
import Split from '@/components/Split.astro';
import Button from '@/components/Button.astro';
import CheckList from '@/components/CheckList.astro';
import ProofStrip from '@/components/local/ProofStrip.astro';
import NumberedCards from '@/components/local/NumberedCards.astro';
import StepsBand from '@/components/local/StepsBand.astro';
import FaqSplit from '@/components/local/FaqSplit.astro';
import AstroMigration from '@/components/local/AstroMigration.astro';
import CtaBand from '@/components/CtaBand.astro';
import Phone from '@/components/Phone.astro';
import AdMock from '@/components/mockups/AdMock.astro';
import { ADS_FAQS } from '@/data/faqs';

const included = [
  'Keyword and competitor research for your area',
  'Campaign build: ad copy, extensions and call ads',
  'Location and schedule targeting',
  'Call and form conversion tracking',
  'Landing page tune-ups on your website',
  'Click fraud protection',
  'Weekly bid, keyword and search-term reviews',
  'Monthly report: spend, calls, leads and cost per lead',
];

const steps = [
  { title: 'Free review', text: 'We talk goals, service area and budget. If you already run ads, I review the account.' },
  { title: 'Build', text: 'Keywords, ads, tracking and landing page set up and tested before launch.' },
  { title: 'Launch', text: 'Ads go live once tracking is tested. I watch daily during the first weeks.' },
  { title: 'Improve', text: 'Weekly tuning and a monthly report on calls, leads and cost per lead.' },
];
---

<BaseLayout
  title="Google Ads Management for Local Businesses | PartnerPress"
  description="Local Google Ads campaigns managed by a Google Partner for one flat monthly fee. Call tracking, no contract, and you own the account."
  nav="google-ads"
>
  <PageHero
    eyebrow="Google Ads management · Marin County and Las Cruces"
    title="Get to the top of Google while your SEO catches up"
    bg={heroPhoto}
  >
    <Fragment slot="lead">
      Local Google Ads campaigns built to make your phone ring, managed by a Google Partner for one flat monthly fee. You
      own the account. No contract.
    </Fragment>
    <Fragment slot="actions">
      <Button href="/contact/" size="lg">Book a free call</Button>
      <span class="hero-note">Already running ads? I'll review your account on the call.</span>
    </Fragment>
    <AdMock slot="aside" />
  </PageHero>

  <ProofStrip
    items={[
      { icon: 'award', value: 'Google Partner', label: 'Certified ads management' },
      { icon: 'dollar', value: 'One flat fee', label: 'No percentage of spend' },
      { icon: 'key', value: 'You own it', label: 'Your account and data' },
      { icon: 'unlock', value: 'No contract', label: 'Month to month' },
    ]}
  />

  <NumberedCards
    eyebrow="Why Google Ads"
    title="Calls this month, not next year"
    lead="SEO builds over months. Ads put you in front of people searching right now, and the data shows which keywords are worth ranking for."
    numbered={false}
    columns={4}
    items={[
      { icon: 'pin', title: 'Only local searchers', text: 'Ads show only inside your service area, at the hours you can answer the phone.' },
      { icon: 'dollar', title: 'Pay for clicks, not views', text: 'You pay Google only when someone clicks or calls, and you set the budget.' },
      { icon: 'phone', title: 'Every call tracked', text: 'Call and form tracking show exactly which keywords and ads bring in customers.' },
      { icon: 'filter', title: 'Wasted spend blocked', text: 'Negative keywords and click fraud protection keep your budget on real customers.' },
    ]}
  />

  <section class="lp-band lp-band--subtle">
    <div class="container">
      <div class="lp-head">
        <span class="eyebrow">What's included</span>
        <h2 class="title-md">Everything from setup to the monthly report</h2>
      </div>
      <div class="lp-card included">
        <CheckList items={included} columns />
      </div>
    </div>
  </section>

  <Section>
    <Split align="center">
      <SectionIntro slot="side" eyebrow="Pricing" title="One flat fee. No percentage of your spend.">
        My fee stays the same as your budget grows, so I never have a reason to push you to spend more. Your ad budget goes
        straight to Google, on your own card.
      </SectionIntro>
      <div class="price-card">
        <div>
          <h3>Google Ads management</h3>
          <p class="muted">For one business and one service area.</p>
        </div>
        <span class="price-card__amount">Flat fee<span>/month</span></span>
        <ul>
          <li>Plus your ad budget, paid to Google directly</li>
          <li>A starting budget sized to your area, agreed on our first call</li>
                    <li>Month to month, cancel any time</li>
          <li>You own the account and all its data</li>
        </ul>
        <Button href="/contact/" size="lg" block>Get a free ads review</Button>
      </div>
    </Split>
  </Section>

  <AstroMigration stakes="every dollar of ad spend" tone="subtle" />

  <Section tone="tint" compact>
    <div class="together">
      <div>
        <h2 class="title-sm">Better together: ads and local SEO</h2>
        <p>
          Ads bring calls now and show which searches turn into customers. SEO uses that data to win those searches for free
          over time. Ask about running both.
        </p>
      </div>
      <a href="/local-seo/">See Local SEO plans</a>
    </div>
  </Section>

  <StepsBand title="From first call to first lead" steps={steps} />

  <FaqSplit title="Google Ads questions" faqs={ADS_FAQS} flush />

  <CtaBand title="See what your clicks would cost">
    Free 30-minute call. Marin <Phone office="marin" /> · Las Cruces <Phone office="nm" />
  </CtaBand>
</BaseLayout>

<style>
  .hero-note {
    font-size: 16px;
    color: var(--muted);
  }

  .included {
    padding: 40px;
  }

  @media (max-width: 520px) {
    .included {
      padding: 28px;
    }
  }

  .price-card {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 36px;
    background: var(--white);
    border: 2px solid var(--blue);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-brand);
  }

  .price-card h3 {
    font-size: 24px;
    font-weight: 700;
  }

  .price-card p {
    margin-top: 6px;
    font-size: 15px;
  }

  .price-card__amount {
    font-family: var(--font-heading);
    font-size: 44px;
    font-weight: 800;
    line-height: 1;
    color: var(--ink);
  }

  .price-card__amount span {
    font-size: 17px;
    font-weight: 500;
    color: var(--muted);
  }

  .price-card ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 18px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
    font-size: 15px;
    color: var(--text-strong);
  }

  .together {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 32px;
    align-items: center;
    justify-content: space-between;
  }

  .together > div {
    flex: 1 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .together a {
    font-family: var(--font-heading);
    font-size: 17px;
    font-weight: 600;
  }
</style>
