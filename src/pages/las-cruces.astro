---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Button from '@/components/Button.astro';
import organMountains from '@/assets/img/locations/las-cruces-organ-mountains.jpg';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import Phone from '@/components/Phone.astro';
import ProofStrip from '@/components/local/ProofStrip.astro';
import AreaBand from '@/components/local/AreaBand.astro';
import ServiceShowcase from '@/components/local/ServiceShowcase.astro';
import ReviewPanel from '@/components/local/ReviewPanel.astro';
import FaqSplit from '@/components/local/FaqSplit.astro';
import LinkPills from '@/components/local/LinkPills.astro';
import type { Faq } from '@/data/faqs';
import { SITE, OFFICES } from '@/config/site';

const office = OFFICES.nm;

const faqs: Faq[] = [
  {
    q: 'Can we meet in person?',
    a: 'We start with a free Google Meet call so we can look at your site together. After that, I’m happy to meet at your office around Las Cruces if it helps.',
  },
  {
    q: 'Do you work with businesses in El Paso and Mesilla?',
    a: 'Yes. I work with businesses across Doña Ana County and over the line in El Paso, and can target your ads and Google Business Profile service area to the places your customers are.',
  },
  {
    q: 'Can one person really handle my website, SEO and ads?',
    a: 'For most local service businesses, yes. You get one point of contact who knows your site, your rankings and your ad account, so nothing falls between vendors.',
  },
];
---

<BaseLayout
  title="Las Cruces Web Design, SEO & Google Ads | PartnerPress"
  description="Web design, WordPress care, Local SEO and Google Ads for Las Cruces and Doña Ana County businesses, from a local expert. Call (575) 517-4795."
  nav="locations"
  office="nm"
  schema={['nm']}
>
  <PageHero
    eyebrow="Las Cruces, NM · Doña Ana County"
    title="Web design, Local SEO and Google Ads for Las Cruces businesses"
    bg={organMountains}
  >
    <Fragment slot="lead">
      I live and work in Las Cruces. Your website, your Google Business Profile and your ads, handled by one local expert who
      picks up the phone.
    </Fragment>
    <Fragment slot="actions">
      <Button href="/contact/" size="lg">Book a free call</Button>
      <span class="call">or call <Phone office="nm" strong /></span>
    </Fragment>
  </PageHero>

  <ProofStrip
    items={[
      { icon: 'calendar', value: 'Since 2010', label: 'Building websites' },
      { icon: 'star', value: `${SITE.reviews.rating} rating`, label: `From ${SITE.reviews.count} Google reviews`, accent: true },
      { icon: 'home', value: 'Lives here', label: 'Based in Las Cruces' },
      { icon: 'video', value: 'Meet first', label: 'Free Google Meet call' },
    ]}
  />

  <ServiceShowcase
    tone="white"
    title="What I do for Las Cruces businesses"
    featured={[
      {
        icon: 'megaphone',
        tag: 'Flat monthly fee',
        title: 'Google Ads in Las Cruces',
        href: '/google-ads/',
        text: 'Show up at the top for the searches that bring calls, targeted to Las Cruces, Mesilla and El Paso.',
        more: 'See Google Ads',
      },
      {
        icon: 'pin',
        tag: 'From $1,495/mo',
        title: 'Local SEO and Google Business Profile',
        href: '/local-seo/',
        text: 'Get into the map pack with a complete profile, steady reviews and local pages Google trusts.',
        more: 'See local SEO',
      },
    ]}
    secondary={[
      {
        icon: 'shield',
        title: 'WordPress care plans',
        tag: 'From $249/mo',
        href: '/wordpress-care-plans/',
        text: 'Weekly updates, daily security scans and unlimited quick fixes.',
        more: 'See care plans',
      },
      {
        icon: 'layout',
        title: 'Website design and rebuilds',
        href: '/web-design/',
        text: 'Replace an aging site with a fast, secure website built to turn local visitors into calls.',
        more: 'See web design',
      },
    ]}
  />

  <AreaBand
    title="Areas I serve"
    groups={[
      { label: 'Las Cruces', areas: ['Las Cruces', 'University Park', 'Sonoma Ranch', 'Picacho Hills'] },
      { label: 'Around the valley', areas: ['Mesilla', 'Doña Ana', 'Anthony'] },
      { label: 'Toward El Paso', areas: ['Santa Teresa', 'El Paso, TX'] },
    ]}
  >
    Most work happens over Google Meet, and I can visit your office around Las Cruces when it helps.
  </AreaBand>

  <section class="lp-band">
    <div class="container">
      <ReviewPanel scoreNote="Hundreds of websites since 2010, for brands like Sutter Health and Grifols">
        <CaseStudyCard
          label="Las Cruces client story"
          result="[Las Cruces client] · [RESULT]"
          text="[Two sentences on the problem and what changed. Add a Las Cruces Google review here once the Las Cruces profile is live.]"
          image={false}
        />
      </ReviewPanel>
    </div>
  </section>

  <FaqSplit title="Las Cruces questions" faqs={faqs} flush />

  <LinkPills
    title="More in the region"
    links={[
      { label: 'El Paso', href: '/el-paso/' },
      { label: 'Web design', href: '/web-design/' },
      { label: 'Local SEO', href: '/local-seo/' },
      { label: 'Google Ads', href: '/google-ads/' },
    ]}
  />

  <CtaBand title="Talk to a local web and SEO expert">
    <address>
      {SITE.name}, {office.street}, {office.city}, {office.region}{" "}
      {office.postalCode} · <Phone office="nm" strong />
    </address>
  </CtaBand>
</BaseLayout>

<style>
  .call {
    font-size: 18px;
  }
</style>
