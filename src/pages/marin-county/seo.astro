---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import heroPhoto from '@/assets/img/locations/marin-point-bonita-lighthouse.jpg';
import Button from '@/components/Button.astro';
import Rating from '@/components/Rating.astro';
import type { IconName } from '@/components/Icon.astro';
import ProofStrip from '@/components/local/ProofStrip.astro';
import NumberedCards from '@/components/local/NumberedCards.astro';
import StepsBand from '@/components/local/StepsBand.astro';
import TrustBand from '@/components/local/TrustBand.astro';
import ImageCards from '@/components/local/ImageCards.astro';
import ArrowCards from '@/components/local/ArrowCards.astro';
import FaqSplit from '@/components/local/FaqSplit.astro';
import CtaBand from '@/components/CtaBand.astro';
import Phone from '@/components/Phone.astro';
import ServiceSchema from '@/components/ServiceSchema.astro';
import { SITE } from '@/config/site';
import { MARIN_TOWNS, MARIN_CLIENTS } from '@/data/locations';
import { REVIEWS } from '@/data/reviews';
import { TOWNS } from '@/data/towns';
import type { Faq } from '@/data/faqs';

const description =
  'Local SEO for Marin County businesses from a Novato-based consultant. Map pack rankings, Google Business Profile, reviews and town pages from Novato to Sausalito.';

const marinDifferences: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'map',
    title: 'A long, narrow county',
    text: 'Marin stretches about 30 miles along Highway 101, from Sausalito to Novato. Google weighs distance heavily in the map pack, so a business can rank first in its own town and be invisible two exits away. I plan for each town you want to reach, not one county-wide keyword.',
  },
  {
    icon: 'pin',
    title: 'Neighborhood names matter',
    text: 'People search by the place they live: Greenbrae, Kentfield, Strawberry, Tam Valley, Marinwood. Many of these are not incorporated towns, so Google relies on your pages and your profile to connect you to them.',
  },
  {
    icon: 'target',
    title: 'Small numbers, high value',
    text: 'A search like "marin seo" or "san rafael web design" happens a few dozen times a month. Every one of those is a nearby customer ready to hire, so a few extra calls make a real difference to a Marin business.',
  },
  {
    icon: 'star',
    title: 'Reviews carry extra weight',
    text: 'In a county this size, many service categories have only a handful of strong Google profiles. A steady flow of genuine reviews is often what separates the top three in the map pack from everyone else.',
  },
];

const steps = [
  { title: 'Free ranking check', text: 'See where you show up today for your top searches in each Marin town you serve.' },
  {
    title: 'Fix the foundation',
    text: 'Google Business Profile categories and services, plus the same name, address and phone on your site, Yelp, BBB and Nextdoor.',
  },
  {
    title: 'Build town relevance',
    text: 'Pages for the towns and services with real search demand, each with useful local detail instead of copy-and-paste city pages.',
  },
  {
    title: 'Earn reviews and links',
    text: 'A simple way to ask happy customers for reviews, and links from Marin chambers, nonprofits and community sites.',
  },
  {
    title: 'Track every town',
    text: 'Monthly map scans across Marin show where you rank block by block, explained in plain English.',
  },
];

const faqs: Faq[] = [
  {
    q: 'Can I rank in Marin towns where I don’t have an office?',
    a: 'Usually yes in the regular results, with genuinely useful pages about the work you do there. The map pack is harder, because Google favors businesses close to the searcher. On the free call I’ll tell you honestly which towns are realistic.',
  },
  {
    q: 'Should my Google profile show my address or a service area?',
    a: 'If customers visit you, show the address. If you travel to them, set a service area made up of the towns you actually serve and hide the address. Listing places you never work can hurt more than help.',
  },
  {
    q: 'How soon will I see results in Marin?',
    a: 'Google Business Profile fixes often show up within a few weeks. New pages, reviews and local links build over months. Each monthly report shows exactly what moved and where.',
  },
  {
    q: 'Do we need to meet in person?',
    a: 'No. We start with a free Google Meet call, and most of the work happens remotely with a plain-English report each month. If you’re in Marin and would like to meet at your office, I’m happy to.',
  },
];
---

<BaseLayout
  title="Marin SEO Services for Local Businesses | PartnerPress"
  description={description}
  nav="locations"
  office="marin"
  schema={['marin']}
  image={heroPhoto}
>
  <ServiceSchema
    slot="head"
    office="marin"
    name="Marin SEO"
    serviceType="Local search engine optimization"
    description={description}
    path="/marin-county/seo/"
    areas={MARIN_TOWNS}
    region="CA"
  />

  <PageHero eyebrow="Marin SEO · Based in Novato" title="Marin SEO that gets you into the map pack, town by town" bg={heroPhoto}>
    <Fragment slot="lead">
      I’m Shane Barnes, a local SEO consultant in Novato. I help Marin businesses show up when people in San Rafael,
      Mill Valley and the rest of the county search for what they do.
    </Fragment>
    <Fragment slot="actions">
      <Button href="/contact/" size="lg">Get a free Marin ranking check</Button>
      <span class="call">or call <Phone office="marin" strong /></span>
    </Fragment>
    <Rating slot="meta" />
  </PageHero>

  <ProofStrip
    items={[
      { icon: 'calendar', value: 'Since 2010', label: 'Helping Marin businesses' },
      { icon: 'star', value: `${SITE.reviews.rating} rating`, label: `From ${SITE.reviews.count} Google reviews`, accent: true },
      { icon: 'home', value: 'Based in Novato', label: 'Local to Marin' },
      { icon: 'video', value: 'Meet first', label: 'Free Google Meet call' },
    ]}
  />

  <NumberedCards
    eyebrow="Local knowledge"
    title="Why ranking in Marin is different"
    lead="Generic SEO advice is written for big cities. Marin’s geography and search habits call for a different plan."
    items={marinDifferences}
    columns={2}
  />

  <StepsBand tone="subtle" title="How I get Marin businesses found" steps={steps} min={190} />

  <TrustBand
    eyebrow="Practice what I preach"
    title="Proof close to home"
    lead="PartnerPress holds a 5.0 rating from 19 Google reviews, built with the same process I use for clients."
    names={MARIN_CLIENTS}
    review={REVIEWS.jae}
  />

  <ImageCards
    eyebrow="Ranking by town"
    title="Towns I work in"
    tone="subtle"
    items={TOWNS.map((t) => ({
      image: t.hero,
      imagePosition: t.heroPosition,
      title: t.name,
      text: t.teaser,
      href: `/marin-county/${t.slug}/`,
      more: `Web design and SEO in ${t.name}`,
    }))}
  />

  <ArrowCards
    eyebrow="Next steps"
    title="Plans, websites and more"
    items={[
      {
        icon: 'dollar',
        title: 'Plans and pricing',
        text: 'Marin SEO plans start at $1,495 a month, month to month, with site care included.',
        href: '/local-seo/#pricing',
        more: 'Compare plans',
      },
      {
        icon: 'layout',
        title: 'Is your website holding you back?',
        text: 'Rankings bring visitors; the site turns them into calls. See how I design websites for Marin businesses.',
        href: '/marin-county/web-design/',
        more: 'See Marin web design',
      },
      {
        icon: 'map',
        title: 'Everything I do in Marin County',
        text: 'Web design, WordPress care, local SEO and Google Ads for businesses from Novato to Sausalito.',
        href: '/marin-county/',
        more: 'See Marin County',
      },
    ]}
  />

  <FaqSplit title="Marin SEO questions" faqs={faqs} flush />

  <CtaBand title="See where you rank across Marin">
    Prefer to talk first? Call <Phone office="marin" />.
  </CtaBand>
</BaseLayout>

<style>
  .call {
    font-size: 18px;
    color: var(--text-strong);
  }
</style>
