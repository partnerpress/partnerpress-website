---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import heroPhoto from '@/assets/img/locations/marin-battery-spencer.jpg';
import Button from '@/components/Button.astro';
import Rating from '@/components/Rating.astro';
import type { IconName } from '@/components/Icon.astro';
import ProofStrip from '@/components/local/ProofStrip.astro';
import NumberedCards from '@/components/local/NumberedCards.astro';
import TrustBand from '@/components/local/TrustBand.astro';
import ImageCards from '@/components/local/ImageCards.astro';
import ArrowCards from '@/components/local/ArrowCards.astro';
import FaqSplit from '@/components/local/FaqSplit.astro';
import { SITE } from '@/config/site';
import CtaBand from '@/components/CtaBand.astro';
import Phone from '@/components/Phone.astro';
import ServiceSchema from '@/components/ServiceSchema.astro';
import { MARIN_TOWNS, MARIN_CLIENTS } from '@/data/locations';
import { REVIEWS } from '@/data/reviews';
import { TOWNS } from '@/data/towns';
import type { Faq } from '@/data/faqs';

const description =
  'Custom website design for Marin County businesses from a Novato designer working since 2010. Fast, secure, accessible sites with a fixed quote. Call (415) 390-6563.';

const whoFor: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'briefcase',
    title: 'Professional firms',
    text: 'Attorneys, CPAs, financial advisors and consultants in San Rafael, Larkspur and Corte Madera who need a site that earns trust before the first call.',
  },
  {
    icon: 'hammer',
    title: 'Contractors and home services',
    text: 'Builders, landscapers and trades working up and down the 101 corridor, where a clear list of services and towns brings in the right jobs.',
  },
  {
    icon: 'heart',
    title: 'Health and wellness practices',
    text: 'Therapists, dentists, chiropractors and studios that need easy booking and a calm, welcoming first impression.',
  },
  {
    icon: 'school',
    title: 'Nonprofits and schools',
    text: 'Marin organizations that rely on donors, volunteers and families finding clear, accessible information quickly.',
  },
];

const expectations: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'phone',
    title: 'Built for phones first',
    text: 'Most local searches happen on a phone. Click-to-call, directions and a short contact form sit within reach on every page.',
  },
  {
    icon: 'pin',
    title: 'Clear about where you work',
    text: 'Your service area is spelled out town by town, so a customer in Tiburon knows you’ll come to them, and Google does too.',
  },
  {
    icon: 'eye',
    title: 'Easy for every visitor',
    text: 'Marin has one of the oldest populations in the Bay Area. Readable type, strong contrast and keyboard-friendly navigation keep every customer in the conversation.',
  },
  {
    icon: 'wifi',
    title: 'Fast on patchy signal',
    text: 'Cell coverage drops in West Marin and the hills. Lean, pre-built pages load where heavy WordPress and page-builder sites stall.',
  },
];

const faqs: Faq[] = [
  {
    q: 'Can we meet in person?',
    a: 'We start with a free Google Meet call so we can look at your current site together. Later in the project, I’m happy to meet at your office anywhere in Marin.',
  },
  {
    q: 'How much does a website cost in Marin?',
    a: 'It depends on the number of pages, how much writing you need and features like booking or online payments. After a free discovery call you get a fixed quote, so the full cost is clear before any work starts.',
  },
  {
    q: 'What do you build with, and why?',
    a: 'Astro, a modern framework that serves pre-built pages with no database or plugins. Sites load fast, there’s nothing to hack or patch, and you own the code outright, so you’re never locked in to me or to a monthly website builder.',
  },
  {
    q: 'We already have a WordPress site. Do we need a new one?',
    a: 'Not necessarily. A care plan keeps a healthy WordPress site fast and secure. If it’s slow, keeps breaking or is dragging down your rankings, I’ll recommend moving it to Astro with your content and URLs carried over.',
  },
  {
    q: 'Can you also look after the site and our Google rankings?',
    a: 'Yes. Ongoing support covers changes and quick fixes, WordPress care plans start at $249 a month, and Marin SEO plans build on the same site so it keeps bringing in calls.',
  },
];
---

<BaseLayout
  title="Marin Website Design & Development | PartnerPress"
  description={description}
  nav="locations"
  office="marin"
  schema={['marin']}
  image={heroPhoto}
>
  <ServiceSchema
    slot="head"
    office="marin"
    name="Marin web design"
    serviceType="Website design and development"
    description={description}
    path="/marin-county/web-design/"
    areas={MARIN_TOWNS}
    region="CA"
  />

  <PageHero eyebrow="Marin web design · Based in Novato" title="Marin web design for businesses that want the phone to ring" bg={heroPhoto}>
    <Fragment slot="lead">
      I’ve designed and built websites for Marin businesses since 2010. You work directly with me, from the
      first sketch to launch day and beyond.
    </Fragment>
    <Fragment slot="actions">
      <Button href="/contact/" size="lg">Book a free call</Button>
      <span class="call">or call <Phone office="marin" strong /></span>
    </Fragment>
    <Rating slot="meta" />
  </PageHero>

  <ProofStrip
    items={[
      { icon: 'calendar', value: 'Since 2010', label: 'Building Marin websites' },
      { icon: 'star', value: `${SITE.reviews.rating} rating`, label: `From ${SITE.reviews.count} Google reviews`, accent: true },
      { icon: 'fileText', value: 'Fixed quote', label: 'Before any work starts' },
      { icon: 'video', value: 'Meet first', label: 'Free Google Meet call' },
    ]}
  />

  <NumberedCards eyebrow="Who I work with" title="Websites for the businesses that keep Marin running" items={whoFor} numbered={false} columns={4} />

  <NumberedCards tone="subtle" eyebrow="Built for Marin" title="What Marin customers expect from your website" items={expectations} numbered={false} columns={2} />

  <TrustBand
    eyebrow="Local and hands-on"
    title="One designer, close by"
    lead="No account managers or offshore handoffs. I’m in Novato, and the person you talk to is the person who builds your site."
    names={MARIN_CLIENTS}
    review={REVIEWS.gibbs}
  />

  <ImageCards
    eyebrow="Websites by town"
    title="Towns I work in"
    tone="subtle"
    items={TOWNS.map((t) => ({
      image: t.hero,
      imagePosition: t.heroPosition,
      title: t.name,
      text: t.teaser,
      href: `/marin-county/${t.slug}/`,
      more: `Web design and SEO in ${t.name}`,
    }))}
  />

  <ArrowCards
    eyebrow="Next steps"
    title="The process, rankings and more"
    items={[
      {
        icon: 'rocket',
        title: 'How a project runs',
        text: 'Discovery, plan, design, build and launch, with redirects that protect the rankings you already have.',
        href: '/web-design/',
        more: 'See the full process',
      },
      {
        icon: 'search',
        title: 'Get found once you launch',
        text: 'A great site still needs to rank. See how Marin SEO gets you into the map pack in the towns you serve.',
        href: '/marin-county/seo/',
        more: 'See Marin SEO',
      },
      {
        icon: 'map',
        title: 'Everything I do in Marin County',
        text: 'Web design, WordPress care, local SEO and Google Ads for businesses from Novato to Sausalito.',
        href: '/marin-county/',
        more: 'See Marin County',
      },
    ]}
  />

  <FaqSplit title="Marin web design questions" faqs={faqs} flush />

  <CtaBand title="Let’s plan your new Marin website">
    Prefer to talk first? Call <Phone office="marin" />.
  </CtaBand>
</BaseLayout>

<style>
  .call {
    font-size: 18px;
    color: var(--text-strong);
  }
</style>
