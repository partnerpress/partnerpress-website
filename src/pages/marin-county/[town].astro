---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Button from '@/components/Button.astro';
import Rating from '@/components/Rating.astro';
import CtaBand from '@/components/CtaBand.astro';
import Phone from '@/components/Phone.astro';
import ServiceSchema from '@/components/ServiceSchema.astro';
import ProofStrip from '@/components/local/ProofStrip.astro';
import NumberedCards from '@/components/local/NumberedCards.astro';
import AreaBand from '@/components/local/AreaBand.astro';
import ServiceShowcase from '@/components/local/ServiceShowcase.astro';
import ReviewPanel from '@/components/local/ReviewPanel.astro';
import FaqSplit from '@/components/local/FaqSplit.astro';
import LinkPills from '@/components/local/LinkPills.astro';
import { TOWNS, type Town } from '@/data/towns';
import { REVIEWS } from '@/data/reviews';
import { SITE } from '@/config/site';

export function getStaticPaths() {
  return TOWNS.map((town) => ({ params: { town: town.slug }, props: { town } }));
}

interface Props {
  town: Town;
}

const { town } = Astro.props;
const path = `/marin-county/${town.slug}/`;
const review = town.slug === 'novato' ? REVIEWS.maxson : REVIEWS.perry;
const others = TOWNS.filter((t) => t.slug !== town.slug);
---

<BaseLayout
  title={town.title}
  description={town.description}
  nav="locations"
  office="marin"
  schema={['marin']}
  image={town.hero}
>
  <ServiceSchema
    slot="head"
    office="marin"
    name={`Web design and local SEO in ${town.name}`}
    serviceType="Website design and local search engine optimization"
    description={town.description}
    path={path}
    areas={[town.name]}
    region="CA"
  />

  <PageHero eyebrow={town.eyebrow} title={town.h1} bg={town.hero} bgPosition={town.heroPosition}>
    <Fragment slot="lead">{town.lead}</Fragment>
    <Fragment slot="actions">
      <Button href="/contact/" size="lg">Book a free call</Button>
      <span class="call">or call <Phone office="marin" strong /></span>
    </Fragment>
    <Rating slot="meta" />
  </PageHero>

  <ProofStrip
    items={[
      { icon: 'calendar', value: 'Since 2010', label: 'Building Marin websites' },
      { icon: 'star', value: `${SITE.reviews.rating} rating`, label: `From ${SITE.reviews.count} Google reviews`, accent: true },
      { icon: 'clock', value: town.proximity.value, label: town.proximity.label },
      { icon: 'video', value: 'Meet first', label: 'Free Google Meet call' },
    ]}
  />

  <NumberedCards
    eyebrow={`Doing business in ${town.name}`}
    title={`What ${town.name} businesses need online`}
    lead="Three things shape how people here find and choose a local business. Each one points to a different fix."
    items={town.intro.map((f, i) => ({ ...f, icon: town.introIcons[i] ?? 'pin' }))}
  />

  <AreaBand title={`${town.name} neighborhoods I serve`} groups={town.neighborhoodGroups ?? [{ areas: town.neighborhoods }]}>
    Each part of town searches a little differently. {town.neighborhoodsNote}
  </AreaBand>

  <ServiceShowcase
    title={`How I help ${town.name} businesses`}
    featured={[
      {
        icon: 'layout',
        tag: 'Fixed quote up front',
        title: `Web design in ${town.name}`,
        href: '/marin-county/web-design/',
        text: 'Fast, secure, accessible websites built to turn local visitors into calls, with a fixed quote up front.',
        more: 'See web design',
      },
      {
        icon: 'search',
        tag: 'Map pack focus',
        title: `Local SEO in ${town.name}`,
        href: '/marin-county/seo/',
        text: `Google Business Profile, reviews and pages that help you show up when people in ${town.name} search.`,
        more: 'See local SEO',
      },
    ]}
    secondary={[
      {
        icon: 'shield',
        title: 'WordPress care plans',
        tag: 'From $249/mo',
        href: '/wordpress-care-plans/',
        text: 'Weekly updates, daily security scans and unlimited quick fixes.',
        more: 'See care plans',
      },
      {
        icon: 'megaphone',
        title: 'Google Ads',
        href: '/google-ads/',
        text: `Ads targeted to ${town.name} and nearby towns while your organic rankings build.`,
        more: 'See Google Ads',
      },
    ]}
  />

  <section class="lp-band">
    <div class="container">
      <ReviewPanel review={review} />
    </div>
  </section>

  <FaqSplit title={`${town.name} questions`} faqs={town.faqs} flush />

  <LinkPills
    title="More in Marin"
    links={[
      { label: 'All Marin County services', href: '/marin-county/' },
      ...others.map((t) => ({ label: t.name, href: `/marin-county/${t.slug}/` })),
      { label: 'Marin SEO', href: '/marin-county/seo/' },
      { label: 'Marin web design', href: '/marin-county/web-design/' },
    ]}
  />

  <CtaBand title={`Let’s talk about your ${town.name} business`}>
    Prefer to talk first? Call <Phone office="marin" />.
  </CtaBand>
</BaseLayout>

<style>
  .call {
    font-size: 18px;
    color: var(--text-strong);
  }
</style>
