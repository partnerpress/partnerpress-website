---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CheckList from '@/components/CheckList.astro';
import ContactForm from '@/components/ContactForm.astro';
import { OFFICES, BOOKING_URL } from '@/config/site';
import coffeeNotebook from '@/assets/img/contact-coffee-notebook.jpg';
---

<BaseLayout
  title="Book a Free 30-Minute Call | PartnerPress"
  description="Tell me about your business and I'll reply within one business day to set up a free 30-minute call. Marin (415) 390-6563, Las Cruces (575) 517-4795."
  nav="contact"
>
  <section class="contact">
    <Image
      class="contact__bg"
      src={coffeeNotebook}
      alt=""
      widths={[640, 1024, 1600, 2048]}
      sizes="100vw"
      quality={45}
      loading="eager"
      fetchpriority="high"
    />
    <div class="container contact__inner">
      <div class="contact__copy">
        <span class="eyebrow">Free 30-minute call</span>
        <h1 class="title-lg">Let's talk about your business</h1>
        <p class="lead">Tell me a little about your business. I'll reply within one business day to set a time.</p>
        <CheckList
          items={[
            'A quick review of your site and Google presence',
            'At least one thing you can fix this week',
            'No pressure and no long-term contract',
          ]}
        />
      </div>
      <div class="contact__form">
        <ContactForm />
        {
          BOOKING_URL && (
            <p class="booking">
              Rather pick a time yourself? <a href={BOOKING_URL}>Book a Google Meet on my calendar</a>.
            </p>
          )
        }
      </div>
      <div class="contact__offices">
        <div class="offices">
          {
            Object.values(OFFICES).map((o) => (
              <div class="office">
                <strong>{o.short === 'Marin' ? 'Marin County' : o.short}</strong>
                <address>
                  {o.street}, {o.city}, {o.region} {o.postalCode}
                </address>
                <a href={`tel:${o.tel}`}>{o.phone}</a>
              </div>
            ))
          }
        </div>
        <p class="offices__note">Both are home offices. Calls happen by phone or Google Meet.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Black and white photo under a white wash, matching the PageHero photo style. */
  .contact {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(56px, 7vw, 96px);
    background: var(--surface);
  }

  .contact :global(.contact__bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .contact::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.78) 55%, rgba(255, 255, 255, 0.6) 100%);
  }

  /* Desktop: intro and offices on the left, form on the right.
     Phones: intro, then the form, then the offices, so the first field is close to the top. */
  .contact__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    grid-template-areas:
      'copy form'
      'offices form';
    grid-template-rows: auto 1fr;
    gap: 24px 48px;
    align-items: start;
  }

  .contact__copy {
    grid-area: copy;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .contact__form {
    grid-area: form;
    min-width: 0;
  }

  .contact__offices {
    grid-area: offices;
    min-width: 0;
  }

  .offices__note {
    margin-top: 12px;
    font-size: 15px;
    color: var(--muted);
  }

  .booking {
    margin-top: 16px;
    text-align: center;
    font-size: 15px;
  }

  @media (max-width: 860px) {
    .contact__inner {
      grid-template-columns: 1fr;
      grid-template-areas: 'copy' 'form' 'offices';
      grid-template-rows: none;
    }
  }

  .offices {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 16px;
    padding-top: 8px;
  }

  .office {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 20px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 15px;
  }

  .office strong {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
  }

  .office a {
    font-weight: 600;
    color: var(--ink);
  }
</style>
