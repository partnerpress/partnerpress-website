---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Button from '@/components/Button.astro';
import heroPhoto from '@/assets/img/services/care-laptop-hands.jpg';
import Grid from '@/components/Grid.astro';
import PricingCard from '@/components/PricingCard.astro';
import ProofStrip from '@/components/local/ProofStrip.astro';
import NumberedCards from '@/components/local/NumberedCards.astro';
import TrustBand from '@/components/local/TrustBand.astro';
import FaqSplit from '@/components/local/FaqSplit.astro';
import { SITE } from '@/config/site';
import { REVIEWS } from '@/data/reviews';
import CtaBand from '@/components/CtaBand.astro';
import { CARE_PLANS } from '@/data/plans';
import { CARE_FAQS } from '@/data/faqs';
import type { IconName } from '@/components/Icon.astro';

// Bright, lively icon tiles to match the brand. Every color is unique on the page, and neighbors
// (across, and down in 2 and 4 column layouts) come from different color families.
type Item = { icon: IconName; title: string; text: string; color: string };

const allPlans: Item[] = [
  { icon: 'refresh', title: 'WordPress updates', color: '#059669', text: 'Core, theme and plugin updates keep your site stable and secure, and give you the new features in each release.' },
  { icon: 'undo', title: 'Remote backups', color: '#f59e0b', text: 'Off-site backups mean a recent copy of your site is always ready to restore if your server goes down.' },
  { icon: 'shield', title: 'Security scanning', color: '#9333ea', text: 'I scan your site every day for new vulnerabilities and fix what turns up, so Google never blacklists it.' },
  { icon: 'eye', title: 'Uptime and speed', color: '#0ea5e9', text: 'I know the moment your site goes down, so I can get it back up quickly, and I tune it so it loads fast.' },
  { icon: 'search', title: 'Keyword tracking', color: '#ec4899', text: 'I track the keywords that matter to your business so you know exactly where you rank in Google.' },
  { icon: 'wrench', title: 'Broken links and spam', color: '#65a30d', text: 'I find and fix broken links, and a strong spam filter makes sure only real inquiries reach your inbox.' },
  { icon: 'check', title: 'Form testing', color: '#2051c5', text: 'I test your contact forms and key pages. If a form ever fails, you hear from me the same day, with the fix underway.' },
  { icon: 'award', title: 'Premium plugin library', color: '#06b6d4', text: 'Use my licensed premium plugins and save over $1,000 a year on forms, landing pages, pop-ups and more.' },
  { icon: 'hammer', title: 'Unlimited quick fixes', color: '#8b5cf6', text: 'Need a page tweaked, a form updated or a buggy plugin sorted? If it takes 30 minutes or less, it\'s included.' },
  { icon: 'pin', title: 'Google Business Profile check', color: '#22c55e', text: 'Each month I check your Google listing, so customers and AI tools never see wrong hours or old details.' },
  { icon: 'layout', title: 'AI search ready', color: '#e11d48', text: 'Your services, hours and service area are set up on your site in a way AI tools like ChatGPT can read.' },
  { icon: 'chart', title: 'Monthly reporting', color: '#f97316', text: 'You shouldn\'t have to take my word for it. Each month you get a report showing the work done on your site.' },
];

const premium: Item[] = [
  { icon: 'trending', title: 'AI visibility reports', color: '#0f766e', text: 'Do ChatGPT, Gemini and Google AI recommend you? Strive gets a quarterly report. Arrive gets monthly tracking and fixes.' },
  { icon: 'key', title: 'Website firewall', color: '#ef4444', text: 'Scanning finds vulnerabilities. A firewall goes further and blocks attackers before they can exploit them.' },
  { icon: 'home', title: 'Hosting and domain admin', color: '#d946ef', text: 'Sites go down when a renewal is missed or a card expires. I handle the renewals and billing details for you.' },
  { icon: 'briefcase', title: 'Legal policy monitoring', color: '#14b8a6', text: 'Privacy laws change often. I monitor and update your site policies so you stay compliant.' },
  { icon: 'users', title: 'Accessibility monitoring', color: '#3b82f6', text: 'I watch for and fix issues that keep visitors with disabilities from using and understanding your site.' },
  { icon: 'store', title: 'Advanced maintenance', color: '#eab308', text: 'Stores, courses, memberships and third-party integrations get the extra care and testing they need.' },
  { icon: 'target', title: 'SEO readiness', color: '#b91c1c', text: 'Each month I fix fundamental SEO issues as they come up, so your site is ready for your next SEO campaign.' },
  { icon: 'rocket', title: 'Priority support', color: '#4f46e5', text: 'Urgent issue? You jump to the front of the queue, so you can focus on your customers instead of your website.' },
];
---

<BaseLayout
  title="WordPress Maintenance Plans from $249/mo | PartnerPress"
  description="WordPress care that keeps your site safe, your forms working and your business visible in Google and AI search. Month-to-month plans from $249."
  nav="care"
>
  <PageHero eyebrow="WordPress Success Plans" title="Your website, protected and found." bg={heroPhoto} centered>
    <Fragment slot="lead">
      Your site is how customers find you, on Google, in Maps, and now in AI answers from ChatGPT and Google. Since 2010,
      I've kept small business WordPress sites safe, fast and bringing in leads. Month to month, cancel any time.
    </Fragment>
    <Fragment slot="actions">
      <Button href="/contact/" size="lg">Get a free AI visibility check</Button>
      <Button href="#plans" variant="secondary" size="lg">Compare plans</Button>
    </Fragment>
  </PageHero>

  <ProofStrip
    items={[
      { icon: 'calendar', value: 'Since 2010', label: 'Caring for WordPress sites' },
      { icon: 'star', value: `${SITE.reviews.rating} rating`, label: `From ${SITE.reviews.count} Google reviews`, accent: true },
      { icon: 'unlock', value: 'No contract', label: 'Month to month' },
      { icon: 'wrench', value: 'Unlimited fixes', label: 'Quick tasks at no extra charge' },
    ]}
  />

  <NumberedCards
    id="included"
    eyebrow="Included in every plan"
    title="Everything your WordPress site needs to stay healthy"
    numbered={false}
    columns={4}
    items={allPlans}
  />

  <NumberedCards
    tone="subtle"
    eyebrow="Strive and Arrive plans"
    title="Premium plans go further"
    lead="Strive adds AI visibility reports, a website firewall, hosting and domain admin, legal policy monitoring and accessibility monitoring. Arrive adds monthly AI visibility fixes, advanced maintenance, SEO readiness and priority support."
    numbered={false}
    columns={4}
    items={premium}
  />

  <NumberedCards
    id="ai-visibility"
    eyebrow="AI visibility"
    title="When customers ask AI, does it name you?"
    lead="Nearly half of consumers now use AI tools like ChatGPT and Google's AI answers to find local services, and those tools usually name one to three businesses, not ten. They decide from your website, your Google listing and your reviews. Every plan keeps those details accurate and readable. Strive and Arrive go further: I check whether AI tools recommend you for your top services, show you the results, and fix what's holding you back."
    numbered={false}
    columns={3}
    items={[
      { icon: 'search', title: 'Readable', text: 'Your services, hours and service area set up so AI tools can understand them.' },
      { icon: 'pin', title: 'Accurate', text: 'Your Google listing checked monthly, so AI never gives customers wrong hours or old details.' },
      { icon: 'chart', title: 'Measured', text: 'A report showing which AI tools mention you, and for which searches.' },
    ]}
  />

  <section class="lp-band" id="plans" aria-label="Plans">
    <div class="container">
      <div class="lp-head">
        <span class="eyebrow">Plans</span>
        <h2 class="title-md">Pick the care your site needs</h2>
      </div>
      <Grid min={300} class="plans">
        {CARE_PLANS.map((plan) => <PricingCard plan={plan} showPerDay />)}
      </Grid>
      <p class="plans-help">Not sure which plan fits? <a href="/contact/">Get a free AI visibility check</a> and I'll recommend one.</p>
    </div>
  </section>

  <NumberedCards
    tone="subtle"
    eyebrow="Plan details"
    title="How the plans work"
    numbered={false}
    columns={3}
    items={[
      { icon: 'unlock', title: 'No contract', text: 'Month to month. Cancel at the end of any term.' },
      { icon: 'undo', title: 'If an update breaks something', text: 'I roll the site back to the last good version and tell you what happened.' },
      { icon: 'award', title: 'WordPress specialists', text: 'Care plans are for WordPress sites. Running Local SEO or Google Ads? Ask about moving to Astro.' },
    ]}
  />

  <TrustBand eyebrow="Reviews" title="Sites that stay up and stay current" review={REVIEWS.perry} />

  <FaqSplit title="Care plan questions" faqs={CARE_FAQS} flush />

  <CtaBand title="Find out if AI recommends your business." button="Book my free check">
    Book a free 20 minute AI visibility check. I'll show you whether ChatGPT and Google's AI mention you for your top
    services, what your site and Google listing are telling them, and which plan fits. No pressure, no contract.
  </CtaBand>
</BaseLayout>

<style>
  :global(.plans) {
    align-items: stretch;
  }
</style>
