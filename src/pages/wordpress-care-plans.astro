---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import heroPhoto from '@/assets/img/services/care-laptop-hands.jpg';
import Grid from '@/components/Grid.astro';
import PricingCard from '@/components/PricingCard.astro';
import ProofStrip from '@/components/local/ProofStrip.astro';
import NumberedCards from '@/components/local/NumberedCards.astro';
import TrustBand from '@/components/local/TrustBand.astro';
import FaqSplit from '@/components/local/FaqSplit.astro';
import { SITE } from '@/config/site';
import { REVIEWS } from '@/data/reviews';
import CtaBand from '@/components/CtaBand.astro';
import { CARE_PLANS } from '@/data/plans';
import { CARE_FAQS } from '@/data/faqs';
import type { IconName } from '@/components/Icon.astro';

// Every icon color is unique on the page, and neighbors (across, and down in 2 and 4 column layouts)
// come from different color families. Each glyph has 3:1 or better contrast on its tint.
type Item = { icon: IconName; title: string; text: string; color: string; tint: string };

const allPlans: Item[] = [
  { icon: 'refresh', title: 'WordPress updates', color: '#d35400', tint: '#f8e5d9', text: 'Core, theme and plugin updates keep your site stable and secure, and give you the new features in each release.' },
  { icon: 'undo', title: 'Remote backups', color: '#1e8a2e', tint: '#ddede0', text: 'Off-site backups mean a recent copy of your site is always ready to restore if your server goes down.' },
  { icon: 'shield', title: 'Security scanning', color: '#26307a', tint: '#dee0eb', text: 'I scan your site every day for new vulnerabilities and fix what turns up, so Google never blacklists it.' },
  { icon: 'zap', title: 'Load time optimization', color: '#7a4519', tint: '#ebe3dc', text: 'Slow sites send visitors elsewhere. I monitor your load time and tune the site so it loads fast.' },
  { icon: 'eye', title: 'Uptime monitoring', color: '#d6005f', tint: '#f9d9e7', text: 'Every site goes down at some point. I know the moment yours does, so I can get it back up quickly.' },
  { icon: 'search', title: 'Keyword tracking', color: '#1a6fd6', tint: '#dde9f9', text: 'I track the keywords that matter to your business so you know exactly where you rank in Google.' },
  { icon: 'wrench', title: 'Broken link monitoring', color: '#2c5a1a', tint: '#dfe6dd', text: 'Broken links frustrate visitors and hurt SEO. I find them and fix them so you don\'t have to.' },
  { icon: 'check', title: 'Quality testing', color: '#c0008f', tint: '#f6d9ee', text: 'I take screenshots and test forms, carts and other key features to make sure everything still works.' },
  { icon: 'filter', title: 'Spam filtering', color: '#0000d9', tint: '#d9d9f9', text: 'A strong spam filter stops almost all form spam, so only real inquiries reach your inbox.' },
  { icon: 'award', title: 'Premium plugin library', color: '#5f7300', tint: '#e7ead9', text: 'Use my licensed premium plugins and save over $1,000 a year on forms, landing pages, pop-ups and more.' },
  { icon: 'hammer', title: 'Unlimited quick fixes', color: '#d10f0f', tint: '#f8dbdb', text: 'Need a page tweaked, a form updated or a buggy plugin sorted? If it takes 30 minutes or less, it\'s included.' },
  { icon: 'chart', title: 'Monthly reporting', color: '#4f5d6b', tint: '#e5e7e9', text: 'You shouldn\'t have to take my word for it. Each month you get a report showing the work done on your site.' },
];

const premium: Item[] = [
  { icon: 'key', title: 'Website firewall', color: '#8c4681', tint: '#eee3ec', text: 'Scanning finds vulnerabilities. A firewall goes further and blocks attackers before they can exploit them.' },
  { icon: 'home', title: 'Hosting and domain admin', color: '#00806f', tint: '#d9ece9', text: 'Sites go down when a renewal is missed or a card expires. I handle the renewals and billing details for you.' },
  { icon: 'briefcase', title: 'Legal policy monitoring', color: '#9a7400', tint: '#f0ead9', text: 'Privacy laws change often. I monitor and update your site policies so you stay compliant.' },
  { icon: 'users', title: 'Accessibility monitoring', color: '#6a3fd1', tint: '#e9e2f8', text: 'I watch for and fix issues that keep visitors with disabilities from using and understanding your site.' },
  { icon: 'store', title: 'Advanced maintenance', color: '#007f99', tint: '#d9ecf0', text: 'Stores, courses, memberships and third-party integrations get the extra care and testing they need.' },
  { icon: 'target', title: 'SEO readiness', color: '#7d1233', tint: '#ecdbe0', text: 'Each month I fix fundamental SEO issues as they come up, so your site is ready for your next SEO campaign.' },
  { icon: 'rocket', title: 'Priority support', color: '#8e24aa', tint: '#eedef2', text: 'Urgent issue? You jump to the front of the queue, so you can focus on your customers instead of your website.' },
];
---

<BaseLayout
  title="WordPress Maintenance Plans from $249/mo | PartnerPress"
  description="Weekly updates, daily security scans, backups, uptime monitoring and unlimited quick fixes. Month-to-month WordPress care plans from $249."
  nav="care"
>
  <PageHero eyebrow="WordPress care plans" title="Your WordPress site, handled. Every week." bg={heroPhoto} centered>
    <Fragment slot="lead">
      Updates, security, backups, monitoring and unlimited small fixes from a WordPress specialist who has been doing this
      since 2010. Month to month. Cancel any time.
    </Fragment>
  </PageHero>

  <ProofStrip
    items={[
      { icon: 'calendar', value: 'Since 2010', label: 'Caring for WordPress sites' },
      { icon: 'star', value: `${SITE.reviews.rating} rating`, label: `From ${SITE.reviews.count} Google reviews`, accent: true },
      { icon: 'unlock', value: 'No contract', label: 'Month to month' },
      { icon: 'wrench', value: 'Unlimited fixes', label: 'Quick tasks at no extra charge' },
    ]}
  />

  <NumberedCards
    id="included"
    eyebrow="Included in every plan"
    title="Everything your WordPress site needs to stay healthy"
    numbered={false}
    columns={4}
    items={allPlans}
  />

  <NumberedCards
    tone="subtle"
    eyebrow="Strive and Arrive plans"
    title="Premium plans go further"
    lead="Strive adds a website firewall, hosting and domain admin, legal policy monitoring and accessibility monitoring. Arrive adds advanced maintenance, SEO readiness and priority support."
    numbered={false}
    columns={4}
    items={premium}
  />

  <section class="lp-band" id="plans" aria-label="Plans">
    <div class="container">
      <div class="lp-head">
        <span class="eyebrow">Plans</span>
        <h2 class="title-md">Pick the care your site needs</h2>
      </div>
      <Grid min={300} class="plans">
        {CARE_PLANS.map((plan) => <PricingCard plan={plan} showPerDay />)}
      </Grid>
      <p class="plans-help">Not sure which plan fits? <a href="/contact/">Book a free call</a> and I'll recommend one.</p>
    </div>
  </section>

  <NumberedCards
    tone="subtle"
    eyebrow="Plan details"
    title="How the plans work"
    numbered={false}
    columns={3}
    items={[
      { icon: 'unlock', title: 'No contract', text: 'Month to month. Cancel at the end of any term.' },
      { icon: 'undo', title: 'If an update breaks something', text: 'I roll the site back to the last good version and tell you what happened.' },
      { icon: 'award', title: 'WordPress specialists', text: 'Care plans are for WordPress sites. Running Local SEO or Google Ads? Ask about moving to Astro.' },
    ]}
  />

  <TrustBand eyebrow="Reviews" title="Sites that stay up and stay current" review={REVIEWS.perry} />

  <FaqSplit title="Care plan questions" faqs={CARE_FAQS} flush />

  <CtaBand title="Not sure which plan fits? Let's look at your site together." />
</BaseLayout>

<style>
  :global(.plans) {
    align-items: stretch;
  }
</style>
