---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import heroPhoto from '@/assets/img/services/local-seo-main-street.jpg';
import Section from '@/components/Section.astro';
import SectionIntro from '@/components/SectionIntro.astro';
import Grid from '@/components/Grid.astro';
import type { IconName } from '@/components/Icon.astro';
import Button from '@/components/Button.astro';
import PricingCard from '@/components/PricingCard.astro';
import ProofStrip from '@/components/local/ProofStrip.astro';
import NumberedCards from '@/components/local/NumberedCards.astro';
import ImageCards from '@/components/local/ImageCards.astro';
import TrustBand from '@/components/local/TrustBand.astro';
import FaqSplit from '@/components/local/FaqSplit.astro';
import AstroMigration from '@/components/local/AstroMigration.astro';
import marinPhoto from '@/assets/img/locations/marin-mount-tam.jpg';
import lasCrucesPhoto from '@/assets/img/locations/las-cruces-organ-mountains.jpg';
import CtaBand from '@/components/CtaBand.astro';
import MapPackMock from '@/components/mockups/MapPackMock.astro';
import { OFFICES, SITE } from '@/config/site';
import { SEO_PLANS, seoTotal, formatPrice } from '@/data/plans';
import { SEO_FAQS } from '@/data/faqs';
import { REVIEWS } from '@/data/reviews';

// Bright icon tiles, one unique color each; neighbors come from different color families (same palette as Care Plans).
const included: { icon: IconName; title: string; text: string; color: string }[] = [
  { icon: 'trending', title: 'Website optimization', color: '#059669', text: 'I optimize the pages that target your most valuable keywords, then review and refine them as rankings move.' },
  { icon: 'target', title: 'Competitive analysis', color: '#f59e0b', text: 'I track what your competitors are doing and adjust your strategy to stay a step ahead.' },
  { icon: 'pencil', title: 'Content creation', color: '#9333ea', text: 'New service and city pages every month, written for the searches your customers actually type.' },
  { icon: 'pin', title: 'Listings management', color: '#22c55e', text: 'Your Google Business Profile, Yelp and BBB listings set up and kept consistent to win the map pack.' },
  { icon: 'star', title: 'Reputation management', color: '#0ea5e9', text: 'I monitor your reviews, help you respond, and find ways to bring in more good ones.' },
  { icon: 'search', title: 'Search Console management', color: '#ec4899', text: 'I watch Google Search Console for errors and warnings and fix them, so your site stays healthy in Google.' },
  { icon: 'wrench', title: 'Technical SEO', color: '#65a30d', text: 'Weekly checks for broken links, slow pages, accessibility errors and privacy issues, fixed as they come up.' },
  { icon: 'fileText', title: 'Monthly AI Insight Brief', color: '#2051c5', text: 'A one-page brief for each location: map rankings, AI visibility, reviews and the three actions for next month.' },
  { icon: 'chart', title: 'Traffic analytics', color: '#e11d48', text: 'As visibility grows, traffic grows. I review your analytics for the changes that should shape the strategy.' },
  { icon: 'shield', title: 'Site care included', color: '#06b6d4', text: 'SEO fails on a neglected site. Every plan includes ongoing care for your site, on WordPress or Astro.' },
  { icon: 'shuffle', title: 'Link monitoring', color: '#8b5cf6', text: 'A healthy backlink profile matters. I watch for bad backlinks and ask Google to ignore them.' },
  { icon: 'video', title: 'Strategy meeting', color: '#f97316', text: 'Each quarter we meet over Google Meet to review results and agree on the next steps.' },
];

// AI search band: colors continue the page palette without repeating any service icon color.
const aiSearch: { icon: IconName; title: string; text: string; color: string }[] = [
  { icon: 'eye', title: 'AI visibility tracking', color: '#14b8a6', text: 'I track how often ChatGPT, Google AI Overviews, AI Mode and Gemini recommend you, across your whole service area.' },
  { icon: 'users', title: 'Who AI recommends instead', color: '#d946ef', text: 'See which competitors AI favors and which websites it pulls its answers from, so I know what to fix.' },
  { icon: 'award', title: 'Earning the recommendation', color: '#ea580c', text: 'AI favors businesses with strong reviews and accurate listings on the sites it reads. I build both, plus pages AI can quote.' },
  { icon: 'rocket', title: 'An early-mover edge', color: '#4f46e5', text: 'ChatGPT recommends only about 1.2% of local business locations (SOCi, 2026). Most of your competitors are invisible there too.' },
];

const examples = [1, 2, 3, 4, 6, 10];
---

<BaseLayout
  title="Local SEO Services in Marin County & Las Cruces | PartnerPress"
  description="Get found in the Google map pack and in AI answers like ChatGPT. Google Business Profile, reviews, local content and AI visibility tracking for Marin County and Las Cruces businesses."
  nav="local-seo"
>
  <PageHero eyebrow="Local SEO · Marin County and Las Cruces" title="Get found on Google and in AI answers" bg={heroPhoto}>
    <Fragment slot="lead">
      Most calls from Google start in the map pack and the first few results, and more customers now ask ChatGPT or
      Google's AI who to call. I get your business into both and keep it there, with site care included so the website
      underneath stays fast and healthy.
    </Fragment>
    <Fragment slot="actions">
      <Button href="/contact/" size="lg">Book a free call</Button>
      <Button href="#pricing" variant="secondary" size="lg">See pricing</Button>
    </Fragment>
    <MapPackMock slot="aside" />
  </PageHero>

  <ProofStrip
    items={[
      { icon: 'calendar', value: 'Since 2010', label: 'Helping local businesses' },
      { icon: 'star', value: `${SITE.reviews.rating} rating`, label: `From ${SITE.reviews.count} Google reviews`, accent: true },
      { icon: 'unlock', value: '3-month start', label: 'Then month to month' },
      { icon: 'shield', value: 'Care included', label: 'Site care in every tier' },
    ]}
  />

  <NumberedCards eyebrow="Every plan includes" title="The work that moves local rankings" items={included} numbered={false} columns={4} />

  <NumberedCards
    tone="subtle"
    eyebrow="AI search"
    title="Show up when customers ask AI"
    lead="45% of U.S. consumers now use AI tools like ChatGPT to find local businesses, up from 6% a year earlier (BrightLocal, 2026). Every plan tracks where you appear in AI answers, not just on Google."
    items={aiSearch}
    numbered={false}
    columns={4}
  />

  <Section id="pricing">
    <SectionIntro eyebrow="Pricing" title="Priced by location, so growing costs less">
      Start with your first location, then add locations or nearby cities as you grow. Every plan begins with a 3-month
      first term, then runs month to month. Cancel any time with 30 days' written notice.
    </SectionIntro>
    <Grid min={300} class="plans">
      {SEO_PLANS.map((plan) => <PricingCard plan={plan} />)}
    </Grid>
    <div class="totals">
      <h3 class="totals__title">What it costs by number of locations</h3>
      <table>
        <thead>
          <tr>
            <th scope="col">Locations</th>
            <th scope="col">Per month</th>
            <th scope="col">Per location</th>
          </tr>
        </thead>
        <tbody>
          {
            examples.map((n) => (
              <tr>
                <td>{n}</td>
                <td>{formatPrice(seoTotal(n))}</td>
                <td>{formatPrice(Math.round(seoTotal(n) / n))}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="plans-help">
      No one can honestly guarantee rankings or AI mentions, and I don't. What I promise is the work, shown to you every
      month. Not sure what fits? <a href="/contact/">Book a free call</a> and I'll recommend a setup.
    </p>
  </Section>

  <AstroMigration stakes="every hour of SEO work" tone="tint" />

  <ImageCards
    eyebrow="Where I work"
    title="Local SEO where you are"
    tone="white"
    items={[
      {
        image: marinPhoto,
        title: 'SEO in Marin County',
        text: `Novato, San Rafael, Mill Valley, Sausalito and the rest of Marin. Based in Novato, ${OFFICES.marin.phone}.`,
        href: '/marin-county/seo/',
        more: 'See Marin SEO',
      },
      {
        image: lasCrucesPhoto,
        title: 'SEO in Las Cruces',
        text: `Las Cruces, Mesilla, Doña Ana County and El Paso. Based in Las Cruces, ${OFFICES.nm.phone}.`,
        href: OFFICES.nm.page,
        more: 'See Las Cruces',
      },
    ]}
  />

  <TrustBand eyebrow="Reviews" title="What clients say about the work" review={REVIEWS.jae} tone="subtle" />

  <FaqSplit title="Local SEO questions" faqs={SEO_FAQS} />

  <CtaBand title="Find out where you rank on Google and in AI">
    On a free call I'll show you where you appear for your top searches, whether AI tools recommend you, and what's
    holding you back.
  </CtaBand>
</BaseLayout>

<style>
  :global(.plans) {
    align-items: stretch;
  }

  .totals {
    max-width: 560px;
    margin: 48px auto 0;
  }

  .totals__title {
    margin-bottom: 16px;
    font-size: 20px;
    font-weight: 600;
    text-align: center;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    font-variant-numeric: tabular-nums;
  }

  th,
  td {
    padding: 12px 20px;
    text-align: left;
    border-bottom: 1px solid var(--line);
  }

  th {
    background: var(--blue);
    color: var(--white);
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
  }

  tbody tr:nth-child(even) {
    background: var(--surface);
  }

  tbody tr:last-child td {
    border-bottom: 0;
  }
</style>
