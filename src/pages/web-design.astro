---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import heroPhoto from '@/assets/img/services/web-design-wireframe.jpg';
import Section from '@/components/Section.astro';
import SectionIntro from '@/components/SectionIntro.astro';
import Split from '@/components/Split.astro';
import Grid from '@/components/Grid.astro';
import Button from '@/components/Button.astro';
import CaseStudyCard from '@/components/CaseStudyCard.astro';
import ReviewQuote from '@/components/ReviewQuote.astro';
import type { IconName } from '@/components/Icon.astro';
import ProofStrip from '@/components/local/ProofStrip.astro';
import NumberedCards from '@/components/local/NumberedCards.astro';
import StepsBand from '@/components/local/StepsBand.astro';
import ImageCards from '@/components/local/ImageCards.astro';
import TrustBand from '@/components/local/TrustBand.astro';
import FaqSplit from '@/components/local/FaqSplit.astro';
import marinPhoto from '@/assets/img/locations/marin-mount-tam.jpg';
import lasCrucesPhoto from '@/assets/img/locations/las-cruces-organ-mountains.jpg';
import CtaBand from '@/components/CtaBand.astro';
import Phone from '@/components/Phone.astro';
import { OFFICES, SITE } from '@/config/site';
import BrowserFrame from '@/components/mockups/BrowserFrame.astro';
import { REVIEWS } from '@/data/reviews';
import { WEB_DESIGN_FAQS } from '@/data/faqs';

const included: { icon: IconName; title: string; text: string }[] = [
  { icon: 'zap', title: 'Fast on phones', text: 'Pre-built pages with no plugin or page-builder bloat, aimed at Google\'s "good" Core Web Vitals.' },
  { icon: 'target', title: 'Built to convert', text: 'Click-to-call on every page, short forms, clear next steps, and call and form tracking set up at launch.' },
  { icon: 'search', title: 'SEO-ready', text: "Service and location pages, schema markup, Search Console, and redirects from every old URL so you keep the rankings you've earned." },
  { icon: 'eye', title: 'Accessible', text: 'Designed and tested so everyone can use it, with an accessibility statement and compliant policies.' },
  { icon: 'shield', title: 'Secure by design', text: 'No database, no plugins and no login page to attack, so there is nothing to hack or patch every week.' },
  { icon: 'pencil', title: 'Easy to edit', text: 'Update text, photos and posts yourself in a simple editor, with a walkthrough at launch.' },
];

const startingPoints: { icon: IconName; title: string; text: string }[] = [
  { icon: 'filePlus', title: 'No website yet', text: 'A complete first site with the pages, copy structure and setup a local business needs.' },
  { icon: 'refresh', title: 'An outdated site', text: "A redesign that keeps what works, fixes what doesn't, and protects your existing rankings." },
  { icon: 'shuffle', title: 'A slow WordPress site', text: 'Moving from WordPress, Wix or Squarespace to a faster, safer Astro build, with your content carried over.' },
  { icon: 'wrench', title: 'An inherited mess', text: 'Developer disappeared? I untangle the site, merge duplicates and get it stable again.' },
];

const steps = [
  { title: 'Discovery call', text: 'Goals, services, customers and competitors.' },
  { title: 'Plan', text: 'Sitemap, page goals and a fixed quote.' },
  { title: 'Design', text: 'Homepage and key page designs for your review.' },
  { title: 'Build', text: 'Development on a private staging site.' },
  { title: 'Launch', text: 'Redirects, tracking and testing, then go live.' },
  { title: 'Support', text: 'Changes, updates and help whenever you need it.' },
];
---

<BaseLayout
  title="Web Design for Local Businesses | PartnerPress"
  description="Fast, secure, mobile-first websites built to turn visitors into calls. New sites, redesigns and WordPress migrations with a fixed quote up front."
  nav="web-design"
>
  <PageHero eyebrow="Web design and development" title="A website built to make your phone ring" bg={heroPhoto}>
    <Fragment slot="lead">
      Fast, mobile-first sites for local service businesses, designed around one goal: turning visitors into calls and
      inquiries. Built by a web developer working since 2010.
    </Fragment>
    <Fragment slot="actions">
      <Button href="/contact/" size="lg">Start your project</Button>
      <Button href="#work" variant="secondary" size="lg">See recent work</Button>
    </Fragment>
    <BrowserFrame slot="aside" />
  </PageHero>

  <ProofStrip
    items={[
      { icon: 'calendar', value: 'Since 2010', label: 'Building websites' },
      { icon: 'star', value: `${SITE.reviews.rating} rating`, label: `From ${SITE.reviews.count} Google reviews`, accent: true },
      { icon: 'fileText', value: 'Fixed quote', label: 'Before any work starts' },
      { icon: 'key', value: 'You own it', label: 'Site, domain and content' },
    ]}
  />

  <NumberedCards eyebrow="Every site includes" title="Built right from the start" items={included} numbered={false} />

  <NumberedCards tone="subtle" eyebrow="Starting points" title="Where are you starting from?" items={startingPoints} numbered={false} columns={4} />

  <StepsBand title="How a project runs" steps={steps} min={170} />

  <Section tone="subtle" id="work">
    <SectionIntro title="Recent websites" />
    <Grid min={300}>
      <CaseStudyCard label="[Industry · Town]" result="[Client name]" />
      <CaseStudyCard label="[Industry · Town]" result="[Client name]" />
      <CaseStudyCard label="[Industry · Town]" result="[Client name]" />
    </Grid>
  </Section>

  <TrustBand eyebrow="Reviews" title="What clients say about working with me" review={REVIEWS.perryRebrand}>
    <ReviewQuote review={REVIEWS.wombacher} variant="tint" />
  </TrustBand>

  <Section tone="subtle">
    <Split align="center">
      <SectionIntro slot="side" eyebrow="Pricing" title="A fixed quote before any work starts">
        Every project is quoted after the discovery call, so you know the full cost up front. No hourly surprises.
      </SectionIntro>
      <div class="price-card">
        <span class="price-card__label">Websites</span>
        <span class="price-card__amount"><span>From </span>[PRICE]</span>
        <ul>
          <li>Typical timeline: [X to Y] weeks</li>
          <li>You own the site, the domain and all content</li>
          <li>Hosting set up in your name on Cloudflare</li>
        </ul>
        <Button href="/contact/" size="lg" block>Get a fixed quote</Button>
      </div>
    </Split>
  </Section>

  <ImageCards
    eyebrow="Where I work"
    title="Web design where you are"
    tone="white"
    items={[
      {
        image: marinPhoto,
        title: 'Web design in Marin County',
        text: `Novato, San Rafael, Mill Valley, Sausalito and the rest of Marin. Based in Novato, ${OFFICES.marin.phone}.`,
        href: '/marin-county/web-design/',
        more: 'See Marin web design',
      },
      {
        image: lasCrucesPhoto,
        title: 'Web design in Las Cruces',
        text: `Las Cruces, Mesilla, Doña Ana County and El Paso. Based in Las Cruces, ${OFFICES.nm.phone}.`,
        href: OFFICES.nm.page,
        more: 'See Las Cruces',
      },
    ]}
  />

  <FaqSplit title="Web design questions" faqs={WEB_DESIGN_FAQS} flush />

  <CtaBand title="Ready for a site that works as hard as you do?" button="Start your project">
    Marin <Phone office="marin" /> · Las Cruces <Phone office="nm" />
  </CtaBand>
</BaseLayout>

<style>
  .price-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 36px;
    background: var(--white);
    border: 2px solid var(--blue);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-brand);
  }

  .price-card__label {
    font-size: 15px;
    color: var(--muted);
  }

  .price-card__amount {
    font-family: var(--font-heading);
    font-size: 44px;
    font-weight: 800;
    line-height: 1;
    color: var(--ink);
  }

  .price-card__amount span {
    font-size: 20px;
    font-weight: 600;
    color: var(--muted);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 18px 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
    font-size: 15px;
    color: var(--text-strong);
  }
</style>
