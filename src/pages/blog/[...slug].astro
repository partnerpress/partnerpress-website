---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import CtaBand from '@/components/CtaBand.astro';
import { SITE } from '@/config/site';
import { getPosts, formatDate, type Post } from '@/lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, author, heroImage } = post.data;
// Google shows about 60 characters, so only add the brand when it fits.
const pageTitle = title.length + ' | PartnerPress'.length <= 60 ? `${title} | PartnerPress` : title;
const heroUrl = heroImage
  ? new URL((await getImage({ src: heroImage, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 })).src, Astro.site).href
  : undefined;

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(updatedDate && { dateModified: updatedDate.toISOString() }),
  author: { '@type': 'Person', name: author },
  ...(heroUrl && { image: heroUrl }),
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    logo: { '@type': 'ImageObject', url: `${SITE.url}/assets/img/logo-color.png` },
  },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
});
---

<BaseLayout title={pageTitle} description={description} nav="blog" ogType="article" image={heroImage}>
  <script slot="head" type="application/ld+json" set:html={schema} />

  <Section width="narrow">
    <article class="post">
      <header class="post__header">
        <a class="post__back" href="/blog/">Blog</a>
        <h1 class="title-lg">{title}</h1>
        <p class="post__meta">
          By {author} · <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {
            updatedDate && (
              <>
                {' '}
                · Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
              </>
            )
          }
        </p>
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>
  </Section>

  <CtaBand title="Need help with your WordPress site?">
    Book a free 30-minute call. I'll look at what's going on and tell you what I'd do.
  </CtaBand>
</BaseLayout>

<style>
  .post {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .post__header {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .post__back {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  .post__back::before {
    content: '← ';
  }

  /* Alt is empty because the image repeats the post title shown above it. */
  .post__meta {
    font-size: 15px;
    color: var(--subtle);
  }
</style>
