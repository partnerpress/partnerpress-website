---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import Rating from '@/components/Rating.astro';
import TrustindexReviews from '@/components/TrustindexReviews.astro';
import ServiceShowcase, { type ShowcaseService } from '@/components/local/ServiceShowcase.astro';
import TrustBand from '@/components/local/TrustBand.astro';
import NumberedCards from '@/components/local/NumberedCards.astro';
import FaqSplit from '@/components/local/FaqSplit.astro';
import type { IconName } from '@/components/Icon.astro';
import type { Faq } from '@/data/faqs';
import Phone from '@/components/Phone.astro';
import BusinessSchema from '@/components/BusinessSchema.astro';
import { SERVICES } from '@/data/services';
import { REVIEWS, type Review } from '@/data/reviews';
import bridge from '@/assets/img/home/golden-gate-bridge.jpg';
import shane from '@/assets/img/home/shane-barnes.png';
import grifols from '@/assets/img/clients/grifols.png';
import ghilotti from '@/assets/img/clients/ghilotti-bros.png';
import sutter from '@/assets/img/clients/sutter-health.png';
import msa from '@/assets/img/clients/marin-school-of-the-arts.jpg';
import quinstreet from '@/assets/img/clients/quinstreet.png';

const service = Object.fromEntries(SERVICES.map((s) => [s.key, s]));

const showcaseFeatured: ShowcaseService[] = [
  {
    icon: service['web-design'].icon,
    tag: 'From $1,500',
    title: 'Websites that bring in calls',
    text: 'Fast, clear pages written for your customers, designed so visitors take action when it matters most.',
    href: service['web-design'].href,
    more: 'See web design',
  },
  {
    icon: service['local-seo'].icon,
    tag: 'From $1,495/mo',
    title: 'Visibility in local search',
    text: "Websites don't just appear at the top of Google. I get your business into the map pack and local results, and keep it there.",
    href: service['local-seo'].href,
    more: 'See local SEO',
  },
];

const showcaseSecondary: ShowcaseService[] = [
  {
    icon: service.care.icon,
    tag: 'From $249/mo',
    title: 'WordPress care plans',
    text: "A stable, secure WordPress site that doesn't get hacked or blacklisted by Google.",
    href: service.care.href,
    more: 'See care plans',
  },
  {
    icon: service['google-ads'].icon,
    tag: 'From $500/mo',
    title: 'Google Ads',
    text: 'Ads aimed at the people searching for you right now, tracked down to the phone call, while SEO builds.',
    href: service['google-ads'].href,
    more: 'See Google Ads',
  },
];

const remote: { icon: IconName; title: string; text: string }[] = [
  {
    icon: 'calendar',
    title: 'Calls on your clock',
    text: 'We meet by phone or Google Meet at a time that works in your time zone. Screen sharing makes walkthroughs easy.',
  },
  {
    icon: 'chart',
    title: 'Reports you can read',
    text: "A plain-English report every month: what I did, what changed and what's next, sent to your inbox.",
  },
  {
    icon: 'phone',
    title: 'Your direct line',
    text: 'Questions go straight to me by phone or email, not to a ticket queue or an account manager.',
  },
  {
    icon: 'pin',
    title: 'Local work, anywhere',
    text: 'Local SEO and ads are built around your town, your competitors and your customers, not mine.',
  },
];

const logos = [
  { name: 'Grifols', img: grifols },
  { name: 'Ghilotti Bros. Inc.', img: ghilotti },
  { name: 'Sutter Health', img: sutter },
  { name: 'Marin School of the Arts', img: msa },
  { name: 'QuinStreet', img: quinstreet },
];

const moreReviews: Review[] = [REVIEWS.ralston, REVIEWS.maxson];

const fit: Faq[] = [
  {
    q: 'You have an established service business',
    a: "If your business is a side hustle, a hobby, or you're preparing to close soon, we're not a good fit. I only work with established, growth-focused service businesses that are in it for the long haul.",
  },
  {
    q: 'You have specific, measurable goals',
    a: "You can't hit a target if you don't know what you're aiming for. You know your numbers, and you're ready to do what it takes to improve them.",
  },
  {
    q: "You're invested in your success",
    a: "You value quality work and have a marketing budget. You also understand that I don't work on trade, for \"exposure\" or on the promise of more work to come.",
  },
  {
    q: 'You have a solid team behind you',
    a: "Whether it's in-house staff, a virtual assistant or a full marketing team, you can't do it all yourself. Your focus should be on doing what you do best.",
  },
  {
    q: 'You make time for your partners',
    a: "If we're going to partner on a project, you need to be as invested in it as I am. If you're too busy to make time for it, I can't be of real service to you.",
  },
  {
    q: 'You enjoy what you do for a living',
    a: "Loving what you do makes the hard parts of running a business a lot easier. We're probably a good fit if you look forward to your work.",
  },
];
---

<BaseLayout
  title="Web Design, Local SEO & Google Ads | PartnerPress"
  description="Web design, WordPress care plans, Local SEO and Google Ads for local service businesses across the U.S. Since 2010. Book a free call."
>
  <BusinessSchema slot="head" offices={['marin', 'nm']} organization />

  <section class="hero">
    <Image
      class="hero__bg"
      src={bridge}
      alt=""
      widths={[640, 1024, 1600, 2048]}
      sizes="100vw"
      quality={30}
      loading="eager"
      fetchpriority="high"
    />
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="hero__hi">Hi, I'm Shane</p>
        <h1 class="hero__title">More calls for your local service business.</h1>
        <p class="hero__sub">Your partner for web design, Local SEO and Google Ads.</p>
        <div class="hero__actions">
          <Button href="/contact/" size="lg">Book a free call</Button>
          <Rating />
        </div>
      </div>
      <Image
        class="hero__photo"
        src={shane}
        alt="Shane Barnes, founder of PartnerPress"
        widths={[364, 480, 630]}
        sizes="(max-width: 860px) 400px, 600px"
        quality={70}
        loading="eager"
      />
    </div>
  </section>

  <div class="container panels">
    <div class="panel panel--blue">
      <p class="panel__eyebrow">What I do</p>
      <h2 class="panel__title">I save you time and money</h2>
      <p>
        You've got a full plate and then some. The last thing you should be doing is chasing flaky developers. That's
        where I come in. I've been building websites since 2010, so you can get back to what you do best while I
        handle your website, your rankings and your ads.
      </p>
    </div>
    <div class="panel panel--orange">
      <p class="panel__eyebrow">Why I do it</p>
      <h2 class="panel__title">Your success is my success</h2>
      <p>
        As a young developer, I discovered WordPress in 2010 and was instantly hooked. Since then, I've helped hundreds of
        businesses across the U.S. succeed online. All from home in Marin County and Las Cruces, where I live with my wife,
        our 2 boys and 2 scrappy lap dogs.
      </p>
    </div>
  </div>

  <ServiceShowcase
    tone="subtle"
    eyebrow="How I do it"
    title="One partner for your website, rankings and ads"
    featured={[...showcaseFeatured, ...showcaseSecondary]}
    secondary={[]}
  />

  <TrustBand
    eyebrow="Clients"
    title="Trusted by local businesses and big names alike"
    logos={logos}
    review={REVIEWS.jenkins}
    scoreNote="Since 2010"
  >
    <div class="quotes">
      {
        moreReviews.map((r) => (
          <figure class="lp-card mini">
            <blockquote>"{r.quote}"</blockquote>
            <figcaption>
              {r.photo ? (
                <Image src={r.photo} alt="" width={48} height={48} densities={[1, 2]} />
              ) : (
                <span class="mini__initials" aria-hidden="true">
                  {r.name.split(' ').map((w) => w[0]).join('')}
                </span>
              )}
              <span>
                <strong>{r.name}</strong>
                <span class="mini__note">{r.note}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
    <TrustindexReviews />
  </TrustBand>

  <NumberedCards
    tone="subtle"
    eyebrow="Wherever you are"
    title="Working together, from anywhere in the U.S."
    lead="You don't need to be nearby to work with me. Here's how it works when we're a few time zones apart."
    items={remote}
    numbered={false}
    columns={4}
    id="remote"
  >
    <p class="nearby">
      Close to home? See <a href="/marin-county/web-design/">Marin web design</a>,{' '}
      <a href="/marin-county/seo/">Marin SEO</a> or <a href="/las-cruces/">Las Cruces services</a>.
    </p>
  </NumberedCards>

  <FaqSplit
    eyebrow="Who I work with"
    title="Are we a good fit?"
    faqs={fit}
    schema={false}
    askTitle="Sound like you?"
    askText="If these sound like your business, we're probably a good fit, and I'd love to hear from you."
  />

  <section class="ready">
    <Image class="ready__bg" src={bridge} alt="" widths={[640, 1024, 1600]} sizes="100vw" quality={45} />
    <div class="container container--narrow ready__inner">
      <h2 class="title-lg">Are you ready to get started?</h2>
      <p>
        If you're ready for a reliable, long-term partner for your website, let's talk. I'll give you 30 minutes of my time
        to talk through your needs and how I can help.
      </p>
      <Button href="/contact/" variant="inverse" size="lg">Book a free call</Button>
      <p class="ready__phones">Or call <Phone office="marin" /> · <Phone office="nm" /></p>
    </div>
  </section>

</BaseLayout>

<style>
  .nearby {
    margin-top: 32px;
    color: var(--muted);
  }

  .quotes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .mini {
    margin: 0;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .mini blockquote {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text);
  }

  .mini figcaption {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
    font-size: 15px;
  }

  .mini figcaption :global(img) {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
  }

  .mini figcaption > span {
    display: flex;
    flex-direction: column;
  }

  .mini strong {
    color: var(--ink);
  }

  .mini__initials {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--blue);
    color: var(--white);
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .mini__note {
    color: var(--muted);
    font-size: 14px;
  }

  @media (max-width: 760px) {
    .quotes {
      grid-template-columns: 1fr;
    }
  }

  /* Hero: black and white Golden Gate backdrop with Shane's cut-out photo.
     The bottom padding is the strip the blue and orange panels overlap. */
  .hero {
    --overlap: clamp(56px, 10vw, 150px);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-top: var(--hero-pad-top);
    padding-bottom: var(--overlap);
  }

  /* Background photo plus a white wash, layered behind the hero content */
  .hero :global(.hero__bg),
  .ready :global(.ready__bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero::before,
  .ready::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(255, 255, 255, 0.78);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 24px;
    align-items: end;
  }

  .hero__copy {
    align-self: center;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-block: 24px;
  }

  .hero__hi {
    font-family: var(--font-heading);
    font-size: clamp(22px, 1vw + 16px, 30px);
    font-weight: 700;
    color: var(--ink);
  }

  .hero__title {
    font-size: clamp(38px, 4.4vw + 16px, 64px);
    line-height: 1.05;
    font-weight: 800;
    color: var(--ink);
  }

  .hero__sub {
    font-family: var(--font-heading);
    font-size: clamp(20px, 0.8vw + 16px, 27px);
    font-weight: 700;
    line-height: 1.3;
    color: var(--ink);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 12px;
    font-size: 15px;
    color: var(--text-strong);
  }

  .hero :global(.hero__photo) {
    display: block;
    width: 100%;
    max-width: 600px;
    height: auto;
    justify-self: end;
  }

  /* Blue and orange panels overlapping the bottom of the hero */
  .panels {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-top: calc(-1 * clamp(56px, 10vw, 150px));
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(32px, 4vw, 52px) clamp(28px, 3.4vw, 44px);
    font-size: 18px;
    line-height: 1.6;
  }

  .panel--blue {
    background: var(--blue);
    color: var(--white);
  }

  .panel--orange {
    background: var(--orange);
    color: var(--white);
  }

  .panel__eyebrow {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
  }

  .panel__title {
    font-size: clamp(26px, 1.4vw + 18px, 34px);
    line-height: 1.15;
    font-weight: 800;
    color: inherit;
  }

  /* How I do it */
  }

  }

  }

  }

  }

  }

  }

  /* Client logos */
  }

  }

  /* Testimonials with black and white headshots */
  }

  }

  }

  }

  }

  }

  }

  /* Who I work with */
  }

  }

  }

  }

  }

  }

  }

  }

  }

  :global(.fit-section) {
    padding-top: clamp(40px, 5vw, 64px);
  }

  /* Ready to get started: the bridge again, under a blue wash */
  .ready {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--section-y);
    color: var(--white);
  }

  .ready::before {
    background: rgba(32, 81, 197, 0.96);
  }

  .ready__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
    font-size: 18px;
  }

  .ready h2 {
    color: var(--white);
  }

  .ready__phones {
    font-size: 16px;
  }

  @media (max-width: 860px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: 0;
    }

    /* Phone layout: photo on top, sitting on a bordered white card of the same width */
    .hero {
      --overlap: 56px;
      padding-top: 16px;
    }

    /* Crop to head and shoulders so the headline and button reach the first screen */
    .hero :global(.hero__photo) {
      order: -1;
      width: 100%;
      max-width: none;
      aspect-ratio: 16 / 11;
      object-fit: cover;
      object-position: 50% 0;
    }

    .hero__copy {
      position: relative;
      padding: 28px 22px;
      background: var(--white);
      border: 4px solid var(--ink);
    }

    .panels {
      grid-template-columns: 1fr;
      margin-top: -32px;
    }
  }
</style>
