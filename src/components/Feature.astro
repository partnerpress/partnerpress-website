---
// Short heading plus a sentence or two. Used in "why" and "what's included" grids.
interface Props {
  title: string;
  boxed?: boolean;
  href?: string;
}

const { title, boxed = false, href } = Astro.props;
const Tag = href ? 'a' : 'div';
const hasIcon = Astro.slots.has('icon');
---

<Tag class:list={['feature', boxed && 'feature--boxed', href && 'feature--link']} href={href}>
  {
    hasIcon ? (
      <div class="feature__head">
        <slot name="icon" />
        <h3>{title}</h3>
      </div>
    ) : (
      <h3>{title}</h3>
    )
  }
  <p><slot /></p>
</Tag>

<style>
  .feature {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--text);
    text-decoration: none;
  }

  .feature--boxed {
    padding: 28px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .feature--link:hover {
    color: var(--text);
    border-color: var(--blue-300);
  }

  .feature__head {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  h3 {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: 0;
  }

  p {
    font-size: 16px;
  }
</style>
