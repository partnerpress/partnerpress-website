---
import { formatDate, type Post } from '@/lib/blog';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<article class="post-card" data-tags={post.data.tags.join("|")}>
  <!-- Text-only cards: the old featured graphics have their titles baked in and clash with the black and white site. -->
  <p class="post-card__meta">
    {post.data.tags[0] && <span class="eyebrow">{post.data.tags[0]}</span>}
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
  </p>
  <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
  <p>{post.data.description}</p>
  <span class="post-card__more" aria-hidden="true">Read article →</span>
  {post.data.draft && <span class="post-card__draft">Draft (only visible in local dev)</span>}
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .post-card:hover {
    border-color: var(--blue-300);
  }

  .post-card {
    border-top: 3px solid var(--blue);
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    align-items: baseline;
  }

  time {
    font-size: 14px;
    color: var(--subtle);
  }

  .post-card__more {
    margin-top: auto;
    padding-top: 6px;
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 600;
    color: var(--blue);
  }

  h2 {
    font-size: 21px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
  }

  h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  /* Whole card is clickable through the title link. */
  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  p {
    font-size: 16px;
  }

  .post-card__draft {
    align-self: flex-start;
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    background: var(--orange-50);
    color: var(--orange-700);
    font-size: 13px;
    font-weight: 600;
  }
</style>
