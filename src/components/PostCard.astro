---
import { Image } from 'astro:assets';
import { formatDate, type Post } from '@/lib/blog';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<article class="post-card">
  {
    post.data.heroImage && (
      <Image
        class="post-card__img"
        src={post.data.heroImage}
        alt=""
        widths={[400, 640, 800]}
        sizes="(min-width: 760px) 400px, 100vw"
      />
    )
  }
  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
  <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
  <p>{post.data.description}</p>
  {post.data.draft && <span class="post-card__draft">Draft (only visible in local dev)</span>}
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  /* Featured image bleeds to the card's edges. Alt is empty because the title follows. */
  .post-card__img {
    display: block;
    width: calc(100% + 56px);
    max-width: none;
    height: auto;
    aspect-ratio: 1200 / 627;
    object-fit: cover;
    margin: -28px -28px 8px;
    border-radius: var(--radius) var(--radius) 0 0;
  }

  .post-card:hover {
    border-color: var(--blue-300);
  }

  time {
    font-size: 14px;
    color: var(--subtle);
  }

  h2 {
    font-size: 21px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
  }

  h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  /* Whole card is clickable through the title link. */
  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  p {
    font-size: 16px;
  }

  .post-card__draft {
    align-self: flex-start;
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    background: var(--orange-50);
    color: var(--orange-700);
    font-size: 13px;
    font-weight: 600;
  }
</style>
