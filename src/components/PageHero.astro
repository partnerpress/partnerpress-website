---
// Top-of-page hero: eyebrow, H1, lead, actions and an optional visual on the right.
// Pass `bg` for a full-width black and white photo behind a light wash (location pages).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  tone?: 'tint' | 'navy';
  size?: 'xl' | 'lg';
  /** Center the text when there is no visual. */
  centered?: boolean;
  /** Grayscale background photo, shown behind a white wash. */
  bg?: ImageMetadata;
}

const { eyebrow, title, tone = 'tint', size = 'lg', centered = false, bg } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class:list={['hero', bg ? 'hero--photo' : `hero--${tone}`]}>
  {
    bg && (
      <Image
        class="hero__bg"
        src={bg}
        alt=""
        widths={[640, 1024, 1600, 2048]}
        sizes="100vw"
        quality={45}
        loading="eager"
        fetchpriority="high"
      />
    )
  }
  <div class:list={['container', 'hero__inner', centered && 'hero__inner--centered']}>
    <div class="hero__copy">
      <span class="eyebrow hero__eyebrow">{eyebrow}</span>
      <h1 class:list={[size === 'xl' ? 'title-xl' : 'title-lg']}>{title}</h1>
      {Astro.slots.has('lead') && <div class="lead hero__lead"><slot name="lead" /></div>}
      {Astro.slots.has('actions') && <div class="hero__actions"><slot name="actions" /></div>}
      {Astro.slots.has('meta') && <div class="hero__meta"><slot name="meta" /></div>}
    </div>
    {hasAside && <div class="hero__aside"><slot name="aside" /></div>}
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(56px, 7vw, 96px);
  }

  .hero--tint {
    background: var(--blue-50);
  }

  /* Photo hero: grayscale image under a white wash, like the homepage hero */
  .hero--photo {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(72px, 9vw, 128px);
  }

  .hero--photo :global(.hero__bg) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero--photo::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.78) 55%, rgba(255, 255, 255, 0.6) 100%);
  }

  .hero--photo .hero__copy {
    max-width: 760px;
  }

  .hero--navy {
    background: var(--blue-900);
    color: var(--white);
  }

  .hero--navy h1 {
    color: var(--white);
  }

  .hero__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 48px 56px;
    align-items: center;
  }

  .hero__inner--centered {
    justify-content: center;
    text-align: center;
  }

  .hero__copy {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .hero__inner--centered .hero__copy {
    flex-basis: auto;
    max-width: 820px;
    align-items: center;
  }

  .hero--navy .hero__eyebrow {
    color: var(--blue-300);
  }

  .hero--navy .hero__lead {
    color: var(--blue-100);
  }

  .hero__inner--centered .hero__lead {
    max-width: 38em;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    align-items: center;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    align-items: center;
    font-size: 15px;
  }

  .hero__aside {
    flex: 1 1 380px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
</style>
