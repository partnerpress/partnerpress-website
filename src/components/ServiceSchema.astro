---
// Service and BreadcrumbList structured data for a service-in-a-place page,
// tied to an office's LocalBusiness entry (include that office in the page's `schema` prop).
import { SITE, OFFICES, type OfficeKey } from '@/config/site';

interface Props {
  office: OfficeKey;
  /** Service name, e.g. "Marin SEO". */
  name: string;
  serviceType: string;
  description: string;
  /** Path of this page, e.g. "/marin-county/seo/". */
  path: string;
  /** Towns or cities served, listed as City entries. */
  areas: string[];
  region: string;
}

const { office, name, serviceType, description, path, areas, region } = Astro.props;
const o = OFFICES[office];
const url = `${SITE.url}${path}`;

const json = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${url}#service`,
      name,
      serviceType,
      description,
      url,
      provider: { '@id': `${SITE.url}${o.page}#business` },
      areaServed: areas.map((town) => ({ '@type': 'City', name: `${town}, ${region}` })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/` },
        { '@type': 'ListItem', position: 2, name: o.name, item: `${SITE.url}${o.page}` },
        { '@type': 'ListItem', position: 3, name, item: url },
      ],
    },
  ],
});
---

<script type="application/ld+json" set:html={json} />
