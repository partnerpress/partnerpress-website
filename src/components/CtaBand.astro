---
// Blue call-to-action band that closes most pages.
import Button from './Button.astro';
import Rating from './Rating.astro';

interface Props {
  title: string;
  button?: string;
  href?: string;
}

const { title, button = 'Book a free call', href = '/contact/' } = Astro.props;
---

<section class="cta">
  <div class="container cta__inner">
    <div class="cta__copy">
      <h2 class="title-sm">{title}</h2>
      {Astro.slots.has('default') && <div class="cta__text"><slot /></div>}
    </div>
    <div class="cta__action">
      <Button href={href} variant="inverse" size="lg">{button}</Button>
      <div class="cta__after">
        <Rating />
        {Astro.slots.has('after') && <slot name="after" />}
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(56px, 6vw, 80px);
    background: var(--blue);
    color: var(--white);
  }

  .cta__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 28px 40px;
    align-items: center;
    justify-content: space-between;
  }

  .cta__copy {
    flex: 1 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .cta h2 {
    color: var(--white);
  }

  .cta__text,
  .cta__after {
    color: var(--blue-50);
  }

  .cta__text {
    font-size: 18px;
  }

  .cta__after {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 15px;
  }

  .cta__after :global(.rating__stars) {
    color: var(--orange-300);
  }

  .cta__action {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }
</style>
