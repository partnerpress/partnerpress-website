---
import logo from '@/assets/img/logo-color.svg';
import { SITE, OFFICES, SERVICE_NAV, LEGAL_NAV } from '@/config/site';

const year = new Date().getFullYear();
const offices = Object.values(OFFICES);
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__grid">
      <div class="footer__col">
        <img src={logo.src} alt="PartnerPress" width="180" height="28" loading="lazy" />
        <p>{SITE.tagline}</p>
        {
          OFFICES.marin.mapUrl && (
            <a class="footer__reviews" href={OFFICES.marin.mapUrl} target="_blank" rel="noopener">
              ★★★★★ {SITE.reviews.rating} from {SITE.reviews.count} Google reviews
            </a>
          )
        }
      </div>
      <div class="footer__col">
        <span class="footer__heading">Services</span>
        {SERVICE_NAV.map((item) => <a href={item.href}>{item.mobileLabel ?? item.label}</a>)}
        <a href="/blog/">Blog</a>
      </div>
      {
        offices.map((o) => (
          <div class="footer__col">
            <a class="footer__heading" href={o.page}>
              {o.short === 'Marin' ? 'Marin County' : o.short}
            </a>
            <address>
              {o.street}
              <br />
              {o.city}, {o.region} {o.postalCode}
            </address>
            <a href={`tel:${o.tel}`}>{o.phone}</a>
            {o.links?.map((l) => <a href={l.href}>{l.label}</a>)}
          </div>
        ))
      }
    </div>
    <div class="footer__bottom">
      <span>© {year} {SITE.legalName}. All rights reserved.</span>
      <nav class="footer__legal" aria-label="Legal">
        {LEGAL_NAV.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="javascript:UC_UI.showSecondLayer();" id="usercentrics-psl">Privacy Settings</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--white);
    border-top: 1px solid var(--line);
    color: var(--text);
    font-size: 15px;
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-block: 64px 40px;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 32px;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer__col img {
    height: 28px;
    width: auto;
    align-self: flex-start;
    margin-bottom: 6px;
  }

  .footer a {
    color: var(--text);
    text-decoration: none;
  }

  .footer .footer__reviews {
    font-weight: 600;
    color: var(--text-strong);
  }

  .footer a:hover {
    color: var(--blue);
    text-decoration: underline;
  }

  .footer .footer__heading {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--ink);
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    justify-content: space-between;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 14px;
    color: var(--muted);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }

  .footer .footer__legal a {
    color: var(--muted);
  }

  .footer .footer__legal a:hover {
    color: var(--blue);
  }

  @media (max-width: 720px) {
    .footer {
      padding-bottom: 76px;
    }
  }
</style>
