---
// Termageddon cookie consent banner (Usercentrics), set up for speed.
// 1. Google Consent Mode v2 defaults to "denied" before any other script runs.
// 2. The Usercentrics loader is injected after the page has loaded and painted, so
//    the banner never delays the first paint or the hero image.
// Usercentrics has Google Consent Mode turned on, so it sends the consent update.
// Analytics.astro only downloads gtag.js after the visitor accepts Google Analytics.
// The old uc-block.bundle.js (render blocking) is no longer used: GA4 is the only
// cookie-setting script on the site and it is gated by Analytics.astro instead.
---

<link rel="preconnect" href="https://app.usercentrics.eu" />
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  window.gtag =
    window.gtag ||
    function gtag() {
      window.dataLayer.push(arguments);
    };
  window.gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied',
    wait_for_update: 500,
  });
  (function () {
    function loadCmp() {
      var s = document.createElement('script');
      s.id = 'usercentrics-cmp';
      s.src = 'https://app.usercentrics.eu/browser-ui/latest/loader.js';
      s.setAttribute('data-settings-id', 'km36odzfP65HHt');
      s.async = true;
      document.head.appendChild(s);
    }
    // Wait for the page's first paint as well as the load event: on fast loads the
    // load event can fire before anything is painted, and the banner's script would
    // then delay the first paint. The 4 second fallback makes sure the banner shows.
    var started = false;
    function start() {
      if (started) return;
      started = true;
      setTimeout(loadCmp, 0);
    }
    function afterPaint() {
      if (performance.getEntriesByName('first-contentful-paint').length) return start();
      try {
        new PerformanceObserver(function (list, observer) {
          observer.disconnect();
          start();
        }).observe({ type: 'paint', buffered: true });
      } catch (e) {
        start();
      }
      setTimeout(start, 4000);
    }
    if (document.readyState === 'complete') afterPaint();
    else window.addEventListener('load', afterPaint, { once: true });
  })();
</script>
