export type ValueIconName = keyof typeof ICONS;

interface Props {
  name: ValueIconName;
  size?: number;
}

const { name, size = 44 } = Astro.props;
const icon = ICONS[name];
---

<span
  class="value-icon"
  style={`--vi-size: ${size}px; --vi-color: ${icon.color}; --vi-tint: ${icon.tint};`}
  aria-hidden="true"
>
  <svg viewBox={icon.viewBox} fill="currentColor"><path d={icon.d} /></svg>
</span>

<style>
  .value-icon {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: var(--vi-size);
    height: var(--vi-size);
    border-radius: 50%;
    background: var(--vi-tint);
    color: var(--vi-color);
  }

  svg {
    width: 46%;
    height: 46%;
  }
</style>
