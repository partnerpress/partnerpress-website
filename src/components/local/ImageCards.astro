---
// Linked cards topped with a black and white location photo.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '@/components/Icon.astro';

export interface ImageCard {
  image?: ImageMetadata;
  imagePosition?: string;
  title: string;
  text: string;
  href: string;
  more: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  items: ImageCard[];
  tone?: 'white' | 'subtle';
}

const { eyebrow, title, lead, items, tone = 'subtle' } = Astro.props;
const columns = items.length === 2 ? 2 : 3;
---

<section class:list={['lp-band', tone === 'subtle' && 'lp-band--subtle']}>
  <div class="container">
    <div class="lp-head">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h2 class="title-md">{title}</h2>
      {lead && <p class="lead-text">{lead}</p>}
    </div>
    <div class:list={['cards', `cards--${columns}`]}>
      {
        items.map((c) => (
          <a class="lp-card card" href={c.href}>
            {c.image && (
              <Image
                src={c.image}
                alt=""
                widths={[400, 800]}
                sizes={columns === 2 ? '(max-width: 960px) 100vw, 580px' : '(max-width: 960px) 100vw, 380px'}
                class="card__img"
                style={c.imagePosition ? `object-position: ${c.imagePosition}` : undefined}
              />
            )}
            <div class="card__body">
              <h3>{c.title}</h3>
              <p>{c.text}</p>
              <span class="lp-more">
                {c.more} <Icon name="arrow" size={18} />
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .lead-text {
    font-size: 18px;
    color: var(--muted);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .cards--2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: var(--text);
    text-decoration: none;
    transition:
      box-shadow 200ms ease,
      transform 200ms ease;
  }

  .card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .card:focus-visible {
    outline: none;
    box-shadow: var(--focus);
  }

  .card :global(.card__img) {
    width: 100%;
    height: 200px;
    object-fit: cover;
    filter: grayscale(1);
  }

  .cards--2 .card :global(.card__img) {
    height: 240px;
  }

  .card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
  }

  .card h3 {
    font-size: 22px;
    font-weight: 700;
  }

  .card p {
    font-size: 15px;
  }

  @media (max-width: 960px) {
    .cards,
    .cards--2 {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }

    .card:hover {
      transform: none;
    }
  }
</style>
