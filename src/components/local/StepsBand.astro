---
// Section wrapper for the numbered process steps.
import Steps from '@/components/Steps.astro';

interface Props {
  eyebrow?: string;
  title: string;
  steps: { title: string; text: string }[];
  min?: number;
  tone?: 'white' | 'subtle';
}

const { eyebrow = 'Process', title, steps, min, tone = 'white' } = Astro.props;
---

<section class:list={['lp-band', tone === 'subtle' && 'lp-band--subtle']}>
  <div class="container">
    <div class="lp-head">
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="title-md">{title}</h2>
    </div>
    <Steps steps={steps} min={min} />
  </div>
</section>
