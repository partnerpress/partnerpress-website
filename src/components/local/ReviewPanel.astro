---
// Large review quote beside the Google rating. Without a review, the default slot fills the wide column.
import { Image } from 'astro:assets';
import { SITE } from '@/config/site';
import type { Review } from '@/data/reviews';

interface Props {
  review?: Review;
  /** Short line under the rating, e.g. "Since 2010". */
  scoreNote?: string;
}

const { review, scoreNote } = Astro.props;
const initials = review?.name
  .split(' ')
  .map((w) => w[0])
  .join('');
---

<div class="panel">
  {
    review ? (
      <figure class="lp-card quote">
        <svg class="quote__mark" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 21c3 0 7-1 7-8V5H3v8h4c0 4-2 5-4 5zm11 0c3 0 7-1 7-8V5h-7v8h4c0 4-2 5-4 5z" />
        </svg>
        <blockquote>
          <p>{review.quote}</p>
        </blockquote>
        <figcaption>
          {review.photo ? (
            <Image src={review.photo} alt="" width={96} height={96} class="quote__avatar quote__avatar--photo" />
          ) : (
            <span class="quote__avatar" aria-hidden="true">
              {initials}
            </span>
          )}
          <span>
            <strong>{review.name}</strong>
            <span class="quote__note">{review.note}</span>
          </span>
        </figcaption>
      </figure>
    ) : (
      <slot />
    )
  }
  <div class="lp-card score">
    <span class="eyebrow">Google reviews</span>
    <span class="score__num">{SITE.reviews.rating}</span>
    <span class="score__stars" aria-hidden="true">★★★★★</span>
    <p>Average from {SITE.reviews.count} Google reviews</p>
    {scoreNote && <p class="score__note">{scoreNote}</p>}
  </div>
</div>

<style>
  .panel {
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: 24px;
  }

  .quote {
    margin: 0;
    padding: 48px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    background: var(--blue-50);
    border-color: var(--blue-100);
  }

  .quote__mark {
    width: 44px;
    height: 44px;
    fill: var(--blue);
  }

  .quote blockquote {
    margin: 0;
  }

  .quote blockquote p {
    font-family: var(--font-heading);
    font-size: clamp(20px, 1.2vw + 14px, 28px);
    line-height: 1.35;
    font-weight: 600;
    color: var(--blue-900);
    letter-spacing: -0.01em;
  }

  .quote figcaption {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: auto;
  }

  .quote figcaption > span:last-child {
    display: flex;
    flex-direction: column;
  }

  .quote figcaption strong {
    color: var(--ink);
  }

  .quote__avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--blue);
    color: var(--white);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 700;
  }

  .quote :global(.quote__avatar--photo) {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
  }

  .quote__note {
    font-size: 14px;
    color: var(--muted);
  }

  .score {
    padding: 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 10px;
  }

  .score__num {
    font-family: var(--font-heading);
    font-size: 72px;
    font-weight: 800;
    line-height: 1;
    color: var(--ink);
  }

  .score__stars {
    color: var(--orange);
    font-size: 24px;
    letter-spacing: 3px;
  }

  .score p {
    color: var(--muted);
  }

  .score .score__note {
    color: var(--text-strong);
    font-weight: 500;
    padding-top: 10px;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 960px) {
    .panel {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .quote {
      padding: 28px;
    }
  }
</style>
