---
// Client names or logos, then a review panel beside the Google rating. Extra content (a case study) goes in the default slot.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import NameStrip from '@/components/NameStrip.astro';
import ReviewPanel from './ReviewPanel.astro';
import type { Review } from '@/data/reviews';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  names?: string[];
  /** Client logos, shown in a light strip instead of names. */
  logos?: { name: string; img: ImageMetadata }[];
  review: Review;
  scoreNote?: string;
  tone?: 'white' | 'subtle';
}

const { eyebrow = 'Clients', title, lead, names, logos, review, scoreNote, tone = 'white' } = Astro.props;
---

<section class:list={['lp-band', tone === 'subtle' && 'lp-band--subtle']}>
  <div class="container stack">
    <div class="lp-head head">
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="title-md">{title}</h2>
      {lead && <p class="lead-text">{lead}</p>}
    </div>
    {names && <NameStrip names={names} align="start" />}
    {
      logos && (
        <ul class="lp-card logos" aria-label="Clients">
          {logos.map((logo) => (
            <li>
              <Image src={logo.img} alt={logo.name} height={48} densities={[1, 2]} quality={60} />
            </li>
          ))}
        </ul>
      )
    }
    <ReviewPanel review={review} scoreNote={scoreNote} />
    <slot />
  </div>
</section>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .head {
    margin-bottom: 0;
  }

  .logos {
    list-style: none;
    margin: 0;
    padding: 28px 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-around;
    gap: 28px 44px;
  }

  .logos :global(img) {
    display: block;
    width: auto;
    height: 44px;
    max-width: 180px;
    object-fit: contain;
  }

  .lead-text {
    font-size: 18px;
    color: var(--muted);
  }
</style>
