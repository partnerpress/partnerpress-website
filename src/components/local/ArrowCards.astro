---
// A row of linked next-step cards with icons and arrow links.
import Icon, { type IconName } from '@/components/Icon.astro';

interface Props {
  eyebrow?: string;
  title: string;
  items: { icon: IconName; title: string; text: string; href: string; more: string }[];
  tone?: 'white' | 'subtle';
}

const { eyebrow, title, items, tone = 'white' } = Astro.props;
---

<section class:list={['lp-band', tone === 'subtle' && 'lp-band--subtle']}>
  <div class="container">
    <div class="lp-head">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h2 class="title-md">{title}</h2>
    </div>
    <div class="cards">
      {
        items.map((c) => (
          <a class="lp-card card" href={c.href}>
            <span class="lp-ic lp-ic--sm">
              <Icon name={c.icon} size={22} />
            </span>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
            <span class="lp-more">
              {c.more} <Icon name="arrow" size={18} />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 32px;
    color: var(--text);
    text-decoration: none;
    transition:
      box-shadow 200ms ease,
      transform 200ms ease;
  }

  .card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .card:focus-visible {
    outline: none;
    box-shadow: var(--focus);
  }

  .card h3 {
    font-size: 20px;
    font-weight: 600;
  }

  .card p {
    font-size: 15px;
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }

    .card:hover {
      transform: none;
    }
  }
</style>
