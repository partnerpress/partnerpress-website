---
// Client result card. Fields in [brackets] are placeholders until real case studies are written.
import { Image } from 'astro:assets';
import Placeholder from './Placeholder.astro';

interface Props {
  label: string;
  result: string;
  text?: string;
  /** Screenshot label, or false for a text-only card. */
  image?: string | false;
  /** Real site screenshot; replaces the placeholder. */
  shot?: ImageMetadata;
  /** Alt text for the screenshot. */
  alt?: string;
}

const { label, result, text, image = 'Site screenshot', shot, alt = '' } = Astro.props;
---

<article class="case">
  {
    shot ? (
      <Image class="case__shot" src={shot} alt={alt} loading="eager" widths={[400, 640, 960]} sizes="(min-width: 1000px) 400px, 100vw" />
    ) : (
      image && <Placeholder label={image} ratio="16 / 10" tone="plain" />
    )
  }
  <div class="case__body">
    <span class="case__label">{label}</span>
    <span class="case__result">{result}</span>
    {text && <p>{text}</p>}
  </div>
</article>

<style>
  .case {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .case__shot {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border-bottom: 1px solid var(--line);
  }

  .case__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
  }

  .case__label {
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .case__result {
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--ink);
  }

  p {
    font-size: 16px;
  }
</style>
