---
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
import '@fontsource/poppins/latin-800.css';
// Inter as one variable font file (all weights) instead of three static files.
import '@fontsource-variable/inter/wght.css';
import '@/styles/global.css';
// Preload the heading and body fonts used above the fold so text renders in its final face sooner.
import poppins600 from '@fontsource/poppins/files/poppins-latin-600-normal.woff2?url';
import poppins700 from '@fontsource/poppins/files/poppins-latin-700-normal.woff2?url';
import poppins800 from '@fontsource/poppins/files/poppins-latin-800-normal.woff2?url';
import interVariable from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import CallBar from '@/components/CallBar.astro';
import BusinessSchema from '@/components/BusinessSchema.astro';
import Analytics from '@/components/Analytics.astro';
import CookieConsent from '@/components/CookieConsent.astro';
import { SITE, type NavKey, type OfficeKey } from '@/config/site';
import { isIndexable } from '@/lib/indexing.mjs';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import defaultShareImage from '@/assets/img/home/golden-gate-bridge.jpg';

interface Props {
  title: string;
  description: string;
  nav?: NavKey;
  /** Which office's number the phone call bar dials. */
  office?: OfficeKey;
  /** LocalBusiness schema to include on this page. */
  schema?: OfficeKey[];
  /** Keep this page out of search results even on the live site. */
  noindex?: boolean;
  ogType?: 'website' | 'article';
  /** Image shown when the page is shared on social media. Cropped to 1200x630; smaller images are not enlarged. */
  image?: ImageMetadata;
}

const { title, description, nav, office = 'marin', schema = [], noindex = false, ogType = 'website', image = defaultShareImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const robots = noindex || !isIndexable();
const share = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const shareUrl = new URL(share.src, Astro.site ?? SITE.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <CookieConsent />
    <link rel="preload" href={poppins800} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={poppins700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={poppins600} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interVariable} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content="noindex" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="PartnerPress blog" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    {schema.length > 0 && <BusinessSchema offices={schema} />}
    <slot name="head" />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header current={nav} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CallBar office={office} />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 12px;
    top: -60px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 8px;
    background: var(--blue);
    color: var(--white);
    font-family: var(--font-heading);
    font-weight: 600;
    text-decoration: none;
  }

  .skip-link:focus {
    top: 12px;
    color: var(--white);
  }
</style>
